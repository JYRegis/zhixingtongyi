## MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=aid_education_platform
MYSQL_PORT=3307

## Redis
REDIS_PORT=6379

## RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

## Backend
BACKEND_PORT=8080

## Nginx (optional)
NGINX_PORT=80

## App secrets
JWT_SECRET=please-change-this

# 微信小程序配置
WX_MINIAPP_APPID=your-real-appid
WX_MINIAPP_SECRET=your-real-secret

# 阿里云 OSS 配置
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=zhixingtongyi
ALIYUN_OSS_ACCESS_KEY_ID=你的_AccessKey_ID
ALIYUN_OSS_ACCESS_KEY_SECRET=你的_AccessKey_Secret

# 阿里云 STS 配置（用于生成临时凭证）
ALIYUN_STS_REGION_ID=cn-beijing
ALIYUN_STS_ROLE_ARN=acs:ram::你的RAM角色ARN
ALIYUN_STS_DURATION_SECONDS=900