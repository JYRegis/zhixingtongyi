.chat-list {
  height: 700rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(16, 24, 40, 0.06);
}

.chat-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.chat-row-self {
  align-items: flex-end;
}

.chat-row-other {
  align-items: flex-start;
}

.chat-meta {
  font-size: 22rpx;
  color: #98a2b3;
  margin-bottom: 6rpx;
}

.chat-bubble {
  max-width: 70%;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.bubble-self {
  background: #3b82f6;
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}

.bubble-other {
  background: #f2f4f7;
  color: #101828;
  border-bottom-left-radius: 4rpx;
}

/* 输入区：有内容时不展示 placeholder，避免与已输入文字叠在一起 */
.chat-input {
  min-height: 72rpx;
}
