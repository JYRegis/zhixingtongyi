<view class="container">
  <view class="card">
    <view class="title">信息录入</view>
    <view class="desc">当前身份：{{roleLabel}}。下面只显示和您身份相关的填写项。</view>
  </view>

  <view class="card" style="margin-top: 20rpx;">
    <view wx:if="{{fieldVisible.name}}" class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" placeholder="请输入姓名" data-field="name" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.school}}" class="field">
      <text class="field-label">学校</text>
      <input class="field-input" placeholder="请输入学校" data-field="school" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.grade}}" class="field">
      <text class="field-label">年级</text>
      <input class="field-input" placeholder="请输入年级" data-field="grade" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.subjects}}" class="field">
      <text class="field-label">擅长/需求科目</text>
      <input class="field-input" placeholder="如：数学,英语" data-field="subjects" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.personality}}" class="field">
      <text class="field-label">性格描述</text>
      <textarea class="field-textarea" placeholder="请输入性格与特长描述" data-field="personality" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.availableTime}}" class="field">
      <text class="field-label">可授课时间</text>
      <input class="field-input" placeholder="如：周六 19:00-21:00" data-field="availableTime" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.guardianContact}}" class="field">
      <text class="field-label">监护人联系方式</text>
      <input class="field-input" placeholder="用于紧急联系" data-field="guardianContact" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.learningGoal}}" class="field">
      <text class="field-label">学习目标</text>
      <textarea class="field-textarea" placeholder="请输入阶段学习目标" data-field="learningGoal" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.region}}" class="field">
      <text class="field-label">管辖区域</text>
      <input class="field-input" placeholder="如：云龙县龙兴村" data-field="region" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.managedStudents}}" class="field">
      <text class="field-label">代管学员范围</text>
      <textarea class="field-textarea" placeholder="填写代管年级或班级" data-field="managedStudents" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.organization}}" class="field">
      <text class="field-label">所属机构</text>
      <input class="field-input" placeholder="请输入平台运营单位" data-field="organization" bindinput="onInput" />
    </view>
    <view wx:if="{{fieldVisible.permissionNote}}" class="field">
      <text class="field-label">权限备注</text>
      <textarea class="field-textarea" placeholder="记录授权与审批说明" data-field="permissionNote" bindinput="onInput" />
    </view>
    <button class="btn-primary" bindtap="onSubmit">提交资料</button>
  </view>
</view>
