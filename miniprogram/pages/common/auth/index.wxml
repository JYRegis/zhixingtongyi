<view class="auth-page">
  <view class="auth-hero card">
    <view class="auth-hero-title">完善登录信息</view>
    <view class="auth-hero-desc">身份：{{roleName}} · 手机号与昵称用于联系与展示，头像可选</view>
  </view>

  <view class="auth-section-title">手机号</view>
  <view class="auth-card card">
    <view wx:if="{{savedPhoneItems.length}}" class="auth-sub">在本机使用过的号码（点击选择）</view>
    <view
      wx:for="{{savedPhoneItems}}"
      wx:key="phone"
      class="auth-phone-item {{selectedPhone === item.phone && !showManualPhone ? 'auth-phone-item--on' : ''}}"
      data-phone="{{item.phone}}"
      bindtap="onSelectSavedPhone"
    >
      <text class="auth-phone-num">{{item.display}}</text>
      <text class="auth-phone-tag">选用</text>
    </view>

    <button class="auth-wx-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
      使用微信绑定手机号（需授权）
    </button>
    <view class="auth-hint">正式环境授权后会由服务器解密真实号码；当前为演示逻辑。</view>

    <view class="auth-row-link" bindtap="onShowManualInput">使用其它号码，手动输入</view>
    <input
      wx:if="{{showManualPhone}}"
      class="field-input auth-phone-input"
      type="number"
      maxlength="11"
      placeholder="请输入11位手机号"
      value="{{manualPhone}}"
      bindinput="onManualPhoneInput"
    />
  </view>

  <view class="auth-section-title">头像与昵称</view>
  <view class="auth-card card">
    <view class="auth-sub">头像（可用微信头像或相册）</view>
    <button class="auth-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="auth-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="auth-avatar-placeholder">点击选择头像</view>
    </button>

    <view class="auth-sub" style="margin-top: 24rpx;">昵称（可同步微信昵称或自填）</view>
    <input
      class="field-input auth-nick-input"
      type="nickname"
      placeholder="点击输入区可唤起微信昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
      bindblur="onNicknameBlur"
    />
  </view>

  <button class="btn-primary auth-submit" bindtap="onSubmit">完成并进入</button>
  <view class="auth-foot">返回上一页可重新选择身份。</view>
</view>
