.home-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: linear-gradient(180deg, #e8f1ff 0%, #f5f7fa 38%, #f5f7fa 100%);
}

.home-hero {
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
}

.home-brand {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #3b82f6, #1d4ed8);
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-brand-mark {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.home-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #101828;
  letter-spacing: 4rpx;
}

.home-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #475467;
  line-height: 1.55;
  padding: 0 24rpx;
}

.home-badge-row {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.home-badge {
  font-size: 22rpx;
  color: #175cd3;
  background: rgba(255, 255, 255, 0.85);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.25);
}

.home-section {
  padding: 8rpx 40rpx 24rpx;
}

.home-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

.home-section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.5;
}

.home-cards {
  padding: 0 32rpx;
}

.home-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #3b82f6;
  box-shadow: 0 8rpx 32rpx rgba(16, 24, 40, 0.08);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.home-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(16, 24, 40, 0.06);
}

.home-card-iam {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
  letter-spacing: 1rpx;
}

.home-card-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #667085;
  line-height: 1.55;
}

.home-card-go {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.home-footnote {
  margin: 32rpx 48rpx 0;
  font-size: 22rpx;
  color: #98a2b3;
  line-height: 1.5;
  text-align: center;
}
