page {
  background: #f5f7fa;
  color: #101828;
  font-size: 28rpx;
  min-height: 100%;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 28%),
    linear-gradient(180deg, #eef4ff 0%, #f5f7fa 24%, #f5f7fa 100%);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #eaecf0;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #101828;
  line-height: 1.35;
}

.desc {
  color: #667085;
  line-height: 1.7;
}

.page-hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  box-shadow: 0 18rpx 48rpx rgba(37, 99, 235, 0.28);
}

.page-hero-eyebrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

.page-hero-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #ffffff;
}

.page-hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.page-hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
}

.section-header {
  margin: 32rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0;
  color: #101828;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}

.stat-grid-item {
  width: 33.3333%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.stat-card {
  min-height: 148rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
  border: 1rpx solid #e4e7ec;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
  box-sizing: border-box;
}

.stat-label {
  font-size: 22rpx;
  color: #667085;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #101828;
}

.stat-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #667085;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecf0;
}

.list-row:last-child {
  border-bottom: none;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  background: #eef4ff;
  color: #175cd3;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.badge-warning {
  color: #b54708;
  background: #fffaeb;
}

.badge-success {
  color: #067647;
  background: #ecfdf3;
}

.badge-danger {
  color: #b42318;
  background: #fef3f2;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #344054;
  margin-bottom: 8rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  border: 1rpx solid #d0d5dd;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.field-textarea {
  min-height: 180rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  min-width: 0;
}

.btn-primary,
.btn-secondary {
  margin-top: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(59, 130, 246, 0.22);
}

.btn-secondary {
  color: #175cd3;
  background: #f8faff;
  border: 1rpx solid #dbe7ff;
}

.btn-primary[disabled],
.btn-secondary[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.empty-state {
  text-align: center;
  padding: 40rpx 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}

.surface-note {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  color: #175cd3;
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: #98a2b3;
}

button {
  background: initial;
  padding: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
