@import "./styles/role-theme.wxss";

page {
  background: #f5f7fa;
  color: #101828;
  font-size: 28rpx;
  min-height: 100%;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, var(--ui-radial), transparent 28%),
    linear-gradient(180deg, var(--ui-page-bg-1) 0%, var(--ui-page-bg-2) 24%, #f5f7fa 100%);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #eaecf0;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #101828;
  line-height: 1.35;
}

.desc {
  color: #667085;
  line-height: 1.7;
}

.page-hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--ui-hero-start) 0%, var(--ui-hero-end) 100%);
  box-shadow: 0 18rpx 48rpx rgba(var(--ui-hero-shadow), 0.28);
}

.page-hero-eyebrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

.page-hero-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #ffffff;
}

.page-hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.page-hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
}

.section-header {
  margin: 32rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0;
  color: #101828;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}

.stat-grid-item {
  width: 33.3333%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.stat-card {
  min-height: 148rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, var(--ui-stat-top) 0%, var(--ui-stat-bot) 100%);
  border: 1rpx solid #e4e7ec;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
  box-sizing: border-box;
}

.stat-label {
  font-size: 22rpx;
  color: #667085;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #101828;
}

.stat-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #667085;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecf0;
}

.list-row:last-child {
  border-bottom: none;
}

/* 待审列表内「申请资料」等可点行 */
.list-row--tappable {
  cursor: pointer;
}

.list-row--hover {
  opacity: 0.88;
}

.list-row-cta {
  color: var(--ui-link);
  font-size: 26rpx;
  font-weight: 500;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  background: var(--ui-chip-bg);
  color: var(--ui-chip-text);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.badge-warning {
  color: #b54708;
  background: #fffaeb;
}

.badge-success {
  color: #067647;
  background: #ecfdf3;
}

.badge-danger {
  color: #b42318;
  background: #fef3f2;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #344054;
  margin-bottom: 8rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  border: 1rpx solid #d0d5dd;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.field-textarea {
  min-height: 180rpx;
}

/**
 * 与「请选择学校/年级」等关合态提示统一，用于
 * - input/textarea 的 `placeholder-class`
 * - 页面上可点的伪输入（picker 内 view）的未选态
 */
.form-placeholder-std {
  color: #94a3b8;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  min-width: 0;
}

.btn-primary,
.btn-secondary {
  margin-top: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--ui-primary) 0%, var(--ui-primary-mid) 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(var(--ui-hero-shadow), 0.22);
}

.btn-secondary {
  color: var(--ui-btn-secondary-fg);
  background: var(--ui-btn-secondary-bg);
  border: 1rpx solid var(--ui-btn-secondary-border);
}

.btn-primary[disabled],
.btn-secondary[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.empty-state {
  text-align: center;
  padding: 40rpx 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}

.surface-note {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-note-bg);
  color: var(--ui-surface-note-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: #98a2b3;
}

button {
  background: initial;
  padding: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/**
 * 示范期主路径：分层背景与卡片阶梯（与 role-theme 的 CSS 变量配合）
 * 在页面根节点追加 class 即可，例如 `shell-mesh` / `card-tier`。
 */
.shell-mesh {
  position: relative;
  overflow: hidden;
}

.shell-mesh::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 120% 80% at 10% 0%, var(--ui-radial) 0%, transparent 50%),
    radial-gradient(ellipse 100% 60% at 100% 20%, var(--ui-radial) 0%, transparent 45%),
    linear-gradient(180deg, var(--ui-page-bg-1) 0%, var(--ui-page-bg-2) 40%, #fafafa 100%);
  opacity: 1;
}

.shell-mesh > view,
.shell-mesh > scroll-view,
.shell-mesh > form {
  position: relative;
  z-index: 1;
}

.card-tier {
  position: relative;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(234, 236, 240, 0.95);
  box-shadow: 0 4rpx 0 rgba(16, 24, 40, 0.02), 0 24rpx 48rpx rgba(16, 24, 40, 0.08);
  overflow: hidden;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
