.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 5000;
  box-sizing: border-box;
  background: transparent;
}

.tab-bar-glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid rgba(240, 240, 240, 0.92);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.tab-bar-inner {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 112rpx;
  align-items: stretch;
  padding: 8rpx 10rpx 0;
  box-sizing: border-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 0 2rpx;
  font-size: 20rpx;
  color: #999999;
  box-sizing: border-box;
}

.tab-bar-item-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  padding: 6rpx 0 4rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  transition: background 0.18s ease, transform 0.12s ease;
}

.tab-bar-item--active {
  color: #1677ff;
}

.tab-bar-item--active .tab-bar-item-bubble {
  background: #e6f4ff;
}

.tab-bar-item--active .tab-bar-icon {
  transform: scale(1.04);
}

.tab-bar-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 4rpx;
  transition: transform 0.15s ease;
}

.tab-bar-text {
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx 4rpx;
  font-size: 20rpx;
  font-weight: 700;
}

/* 角色主题下的选中色（与 styles/role-theme.wxss 中 tab-bar 段一致，针对 pill 内文字/图标可继承） */
.tab-bar.theme-guest .tab-bar-item--active {
  color: #1677ff;
}
.tab-bar.theme-student .tab-bar-item--active {
  color: #ea580c;
}
.tab-bar.theme-teacher .tab-bar-item--active {
  color: #1677ff;
}
.tab-bar.theme-l2 .tab-bar-item--active {
  color: #1677ff;
}
.tab-bar.theme-l1 .tab-bar-item--active {
  color: #1677ff;
}

.tab-bar.theme-guest .tab-bar-item--active .tab-bar-item-bubble {
  background: #e6f4ff;
}
.tab-bar.theme-student .tab-bar-item--active .tab-bar-item-bubble {
  background: rgba(234, 88, 12, 0.1);
}
.tab-bar.theme-teacher .tab-bar-item--active .tab-bar-item-bubble {
  background: #e6f4ff;
}
.tab-bar.theme-l2 .tab-bar-item--active .tab-bar-item-bubble {
  background: #e6f4ff;
}
.tab-bar.theme-l1 .tab-bar-item--active .tab-bar-item-bubble {
  background: #e6f4ff;
}


/* 红色未读数量徽标（贴在 tab item 右上角） */
.tab-bar-item-bubble {
  position: relative;
}
.tab-bar-badge {
  position: absolute;
  top: 0;
  right: 18%;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  line-height: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(255, 77, 79, 0.35);
  pointer-events: none;
}

/* 顶部新消息横幅 */
.notif-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: calc(env(safe-area-inset-top) + 18rpx) 28rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.28s ease-out, opacity 0.28s ease-out;
}
.notif-banner--in {
  transform: translateY(0);
  opacity: 1;
}
.notif-banner-icon {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e6f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.notif-banner-body {
  flex: 1 1 auto;
  min-width: 0;
}
.notif-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.notif-banner-content {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.notif-banner-close {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #9ca3af;
  background: transparent;
}
