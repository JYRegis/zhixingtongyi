.create-page {
  padding-bottom: 64rpx;
}

.create-tip-card,
.create-form-card {
  margin-top: 20rpx;
}

.create-tip-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.create-tip-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.create-hint {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 0;
}

.create-warn {
  color: #0958d9;
  font-weight: 700;
}

/* 主题 input 与下方日期/时间/结对口 picker 行统一为单行 88rpx，与入驻页 .field--control 逻辑一致 */
.create-page .field > input.field-input {
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 20rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.create-page .field--control > picker {
  display: block;
  width: 100%;
}

.create-page .field--control .field-input.create-picker-line {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  line-height: 1.45;
  padding: 0 20rpx;
  box-sizing: border-box;
  word-break: break-all;
}
