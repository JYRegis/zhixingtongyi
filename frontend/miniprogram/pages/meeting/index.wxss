.meeting-page {
  padding-bottom: 48rpx;
}

.meeting-hero-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.5;
  text-align: center;
  max-width: 90%;
  margin-left: auto;
  margin-right: auto;
}

.meeting-bar {
  width: 100%;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.meeting-btn-new {
  width: 100% !important;
  margin: 0 !important;
  box-sizing: border-box;
}

.meeting-next-card,
.meeting-history-card {
  margin-top: 20rpx;
}

.meeting-next-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #175cd3;
  font-size: 22rpx;
}

.meeting-next-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #101828;
}

.meeting-history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #101828;
}
