.meeting-page {
  padding-bottom: 48rpx;
}

.meeting-hero-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

.meeting-bar {
  width: 100%;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.meeting-btn-new {
  width: 100% !important;
  margin: 0 !important;
  box-sizing: border-box;
}

.meeting-next-card,
.meeting-history-card {
  margin-top: 20rpx;
}

.meeting-next-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f0ff;
  color: #0066ff;
  font-size: 22rpx;
  font-weight: 700;
}

.meeting-next-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #333333;
}

.meeting-history-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #333333;
}

.meeting-link-empty {
  color: #999999;
}

.meeting-empty-card {
  margin-top: 20rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.meeting-empty-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
}
