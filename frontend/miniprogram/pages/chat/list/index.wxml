<view class="page-shell {{_roleThemeClass}}">
  <view class="chat-list-page">
    <view class="page-hero chat-list-hero">
      <view class="page-hero-eyebrow">MESSAGES</view>
      <view class="page-hero-title">消息</view>
      <view class="page-hero-desc">查看结对沟通、系统提醒与陪伴记录</view>
    </view>

    <view
      class="card chat-l1-filter-card"
      wx:if="{{role === 'admin_level_1' && l1FilterSchools.length}}"
    >
      <view class="field" style="margin: 0">
        <text class="field-label">按学校筛选</text>
        <picker
          range="{{l1FilterSchools}}"
          range-key="name"
          value="{{l1FilterIndex}}"
          bindchange="onL1SchoolFilterChange"
        >
          <view class="field-input"
            >{{l1FilterSchools[l1FilterIndex] ? l1FilterSchools[l1FilterIndex].name : '—'}}</view>
        </picker>
      </view>
    </view>

    <block wx:if="{{pairs.length}}">
      <view class="section-header">
        <view class="section-title">最近</view>
      </view>
      <view
        wx:for="{{pairs}}"
        wx:key="partnerId"
        class="card chat-pair-card"
        data-id="{{item.partnerId}}"
        data-name="{{item.name}}"
        bindtap="onOpenRoom"
      >
        <view class="chat-pair-main">
          <view class="chat-pair-avatar">{{item.avatarText}}</view>
          <view class="chat-pair-content">
        <view class="chat-pair-top">
          <text class="chat-pair-name">{{item.l1DuoLine || item.name}}</text>
          <text class="chat-pair-time">{{item.lastTime}}</text>
        </view>
        <view class="chat-pair-tag" wx:if="{{role === 'admin_level_1' && item.schoolName}}">{{item.schoolName}} · 结对对聊</view>
        <view class="chat-pair-tag" wx:else>{{item.tag}}</view>
        <view class="chat-pair-preview">{{item.lastPreview}}</view>
          </view>
        </view>
        <view class="chat-pair-action">打开</view>
      </view>
    </block>

    <view wx:else class="card chat-empty">
      <view class="empty-title">暂无消息</view>
      <view class="empty-desc">{{emptyHint}}</view>
      <button wx:if="{{role !== 'admin_level_1'}}" class="btn-primary chat-empty-btn" bindtap="toMatch">去匹配</button>
    </view>
  </view>
</view>
