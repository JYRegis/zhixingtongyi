<view class="chat-page">
  <scroll-view
    scroll-y
    class="chat-body"
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
  >
    <view wx:if="{{!messages.length}}" class="chat-empty">
      <view class="chat-empty-icon">💬</view>
      <view class="chat-empty-title">还没有聊天记录</view>
      <view class="chat-empty-desc">发一条消息开始沟通吧</view>
    </view>
    <block wx:for="{{messages}}" wx:key="id">
      <view id="msg-{{item.id}}" class="msg {{item.isSelf ? 'msg--self' : 'msg--other'}}">
        <view class="msg-name">{{item.from}} · {{item.time}}</view>
        <view class="msg-content {{item.isSelf ? 'msg-content--self' : 'msg-content--other'}}">
          <view class="msg-avatar">
            <image wx:if="{{item.isSelf && myAvatarUrl}}" class="msg-avatar-img" src="{{myAvatarUrl}}" mode="aspectFill" />
            <view wx:elif="{{item.isSelf}}" class="msg-avatar-text">{{myAvatarChar}}</view>
            <view wx:else class="msg-avatar-text msg-avatar-text--other">{{item.avatarChar}}</view>
          </view>
          <view class="msg-bubble {{item.isSelf ? 'msg-bubble--self' : 'msg-bubble--other'}}">{{item.text}}</view>
        </view>
      </view>
    </block>
    <view class="chat-body-bottom-pad"></view>
  </scroll-view>

  <view class="chat-bar">
    <view class="chat-bar-inner">
      <view class="chat-bar-icon" bindtap="onMockVoice">
        <view class="icon-mic"></view>
      </view>
      <input
        class="chat-bar-input"
        type="text"
        placeholder="输入消息..."
        value="{{message}}"
        confirm-type="send"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <view class="chat-bar-icon" bindtap="onMockImage">
        <view class="icon-image"></view>
      </view>
      <view wx:if="{{canSend}}" class="chat-bar-send" bindtap="onSend">发送</view>
      <view wx:else class="chat-bar-icon" bindtap="onMoreAction">
        <view class="icon-plus"></view>
      </view>
    </view>
  </view>
</view>
