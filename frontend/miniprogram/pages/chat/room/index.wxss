.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(circle at 12% 0%, rgba(22, 119, 255, 0.1), transparent 24%),
    #f5f7fa;
}

/* 管理/巡览：气泡与标签走灰、左起布局；头像仍用角色色（与下方 --stu / --vol 一致） */
.chat-page--observer {
  background: #f5f7fa;
}

.chat-page--observer .chat-body {
  background: #f5f7fa;
}

/* 不再一侧贴左一侧贴右制造「主账号」感，两侧同左起展示 */
.chat-page--observer .msg--l1stu,
.chat-page--observer .msg--l1vol {
  opacity: 1;
  align-items: flex-start;
}

.chat-page--observer .msg-l1-pill {
  color: #4b5563 !important;
  background: #d1d5db !important;
  font-weight: 500;
}

.chat-page--observer .msg-name--l1 {
  color: #6b7280;
}

/* 与学员侧同向：左到右 头像+气泡，志愿者侧原 row-reverse 在巡览中会导致「我在右边说话」的观感 */
.chat-page--observer .msg-content--l1right {
  flex-direction: row;
}

.chat-page--observer .msg-bubble--l1stu,
.chat-page--observer .msg-bubble--l1vol {
  background: #d1d5db !important;
  color: #374151 !important;
  border: 1rpx solid #bfc4cc !important;
  border-radius: 16rpx !important;
}

.chat-body {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-body-bottom-pad {
  height: 24rpx;
}

/* ---------- empty ---------- */

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
}

.chat-empty-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  color: var(--ui-primary);
  font-size: 52rpx;
  margin-bottom: 24rpx;
}

.chat-empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #333333;
}

.chat-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ---------- message ---------- */

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.msg--self {
  align-items: flex-end;
}

.msg--other {
  align-items: flex-start;
}

/* 一级巡览：学员左、志愿者右，双方均显式标出 */
.msg--l1stu {
  align-items: flex-start;
}

.msg--l1vol {
  align-items: flex-end;
}

.msg-name--l1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 0 8rpx;
}

.msg-l1-pill {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #0066ff;
  background: #e6f0ff;
  font-weight: 700;
}

.msg-content--l1left,
.msg-content--l1right {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  max-width: 82%;
}

.msg-content--l1left {
  flex-direction: row;
}

.msg-content--l1right {
  flex-direction: row-reverse;
}

.msg-avatar-text--stu {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.msg-avatar-text--vol {
  background: linear-gradient(135deg, var(--ui-primary) 0%, var(--ui-primary-mid) 100%);
}

.msg-bubble--l1stu {
  background: #fff;
  color: #1a1a1a;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  border: 1rpx solid #e5e7eb;
}

.msg-bubble--l1vol {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.msg-name {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  padding: 0 60rpx;
}

.msg-content {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  max-width: 82%;
}

.msg-content--self {
  flex-direction: row-reverse;
}

.msg-content--other {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  overflow: hidden;
}

.msg-avatar-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.msg-avatar-text {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--ui-primary) 0%, var(--ui-primary-mid) 100%);
  border-radius: 22rpx;
}

.msg-avatar-text--other {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.msg-bubble {
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble--self {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.msg-bubble--other {
  background: #fff;
  color: #333333;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  border: 1rpx solid #f0f0f0;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

/* ---------- bottom bar ---------- */

.chat-bar {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #f0f0f0;
  padding: 14rpx 16rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}

.chat-bar-inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.chat-bar-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: 1rpx solid #f0f0f0;
}

.chat-bar-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-bar-icon:active {
  opacity: 0.6;
}

.chat-bar-send {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.chat-bar-send:active {
  opacity: 0.86;
}

/* ---------- pure-css icons ---------- */

.icon-mic {
  width: 32rpx;
  height: 40rpx;
  border: 4rpx solid #666;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  position: relative;
}

.icon-mic::after {
  content: "";
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 10rpx;
  border-bottom: 4rpx solid #666;
  border-left: 4rpx solid #666;
  border-right: 4rpx solid #666;
  border-radius: 0 0 14rpx 14rpx;
}

.icon-image {
  width: 38rpx;
  height: 32rpx;
  border: 4rpx solid #666;
  border-radius: 6rpx;
  position: relative;
}

.icon-image::before {
  content: "";
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #666;
}

.icon-image::after {
  content: "";
  position: absolute;
  bottom: 2rpx;
  left: 4rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 14rpx solid #666;
  transform: rotate(180deg);
}

.icon-plus {
  width: 38rpx;
  height: 38rpx;
  position: relative;
}

.icon-plus::before,
.icon-plus::after {
  content: "";
  position: absolute;
  background: #666;
  border-radius: 2rpx;
}

.icon-plus::before {
  top: 50%;
  left: 4rpx;
  right: 4rpx;
  height: 4rpx;
  transform: translateY(-50%);
}

.icon-plus::after {
  left: 50%;
  top: 4rpx;
  bottom: 4rpx;
  width: 4rpx;
  transform: translateX(-50%);
}


/* 图片消息 */
.msg-bubble--image {
  padding: 8rpx;
  background: transparent !important;
  box-shadow: none;
}
.msg-image {
  max-width: 280rpx;
  min-width: 120rpx;
  border-radius: 12rpx;
}
/* 文件消息 */
.msg-file {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.msg-file-icon {
  font-size: 40rpx;
}
.msg-file-name {
  font-size: 26rpx;
  color: #1a73e8;
  word-break: break-all;
  max-width: 360rpx;
}
