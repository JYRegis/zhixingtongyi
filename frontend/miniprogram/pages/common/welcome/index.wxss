.welcome-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #ff8c00 0%, #ffa500 55%, #ffb84d 100%);
  overflow: hidden;
}

.welcome-status-bar {
  width: 100%;
  background: transparent;
}

/* 背景装饰圆 */
.welcome-decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.welcome-decor-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.welcome-decor-circle--lg {
  width: 460rpx;
  height: 460rpx;
  top: -160rpx;
  right: -160rpx;
  background: rgba(255, 255, 255, 0.16);
}

.welcome-decor-circle--md {
  width: 260rpx;
  height: 260rpx;
  top: 240rpx;
  left: -120rpx;
  background: rgba(255, 255, 255, 0.14);
}

.welcome-decor-circle--sm {
  width: 140rpx;
  height: 140rpx;
  top: 540rpx;
  right: 40rpx;
  background: rgba(255, 255, 255, 0.18);
}

/* Hero */
.welcome-hero {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 80rpx 56rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.welcome-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(140, 72, 0, 0.22);
  margin-bottom: 36rpx;
}

.welcome-logo-text {
  font-size: 76rpx;
  font-weight: 800;
  color: #ff8c00;
  letter-spacing: 2rpx;
}

.welcome-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-bottom: 16rpx;
}

.welcome-title {
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.welcome-desc {
  margin-top: 18rpx;
  max-width: 540rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.92);
}

.welcome-chips {
  margin-top: 44rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.welcome-chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(6rpx);
}

/* 底部卡片 */
.welcome-footer {
  position: relative;
  z-index: 1;
  padding: 32rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.welcome-footer-card {
  padding: 32rpx 28rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(240, 240, 240, 0.92);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.12);
}

.welcome-footer-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.welcome-footer-text {
  flex: 1;
  min-width: 0;
}

.welcome-footer-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #333333;
}

.welcome-footer-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #999999;
}

.welcome-footer-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff3df;
  color: #ff8c00;
  font-size: 22rpx;
  font-weight: 700;
}

.welcome-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8c00 0%, #ffa500 100%);
  box-shadow: 0 14rpx 30rpx rgba(255, 140, 0, 0.28);
  border: none;
}

.welcome-btn::after {
  border: none;
}

.welcome-btn[disabled] {
  opacity: 0.7;
}

.welcome-foot-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #999999;
  text-align: center;
}
