.hours-apply-page {
  padding-bottom: 48rpx;
}

.hours-apply-form {
  margin-top: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  margin-top: 24rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-req {
  color: #d92d20;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  border: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333333;
}

.form-picker-arrow {
  font-size: 24rpx;
  color: var(--ui-primary);
  font-weight: 700;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border-radius: 24rpx;
  border: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.form-hint {
  font-size: 22rpx;
  color: #999999;
  margin-top: 10rpx;
  line-height: 1.5;
}

.hours-apply-submit {
  margin-top: 40rpx;
  width: 100%;
  border-radius: 44rpx;
}

.hours-apply-section {
  margin-top: 40rpx;
}

.hours-empty-card {
  margin-top: 20rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.hours-empty-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.hours-record-card {
  margin-top: 20rpx;
}

.hours-status {
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
}

.hours-status--pending {
  color: #0066ff;
  background: #e6f0ff;
}

.hours-status--approved {
  color: #15803d;
  background: #dcfce7;
}

.hours-status--rejected {
  color: #b42318;
  background: #fee4e2;
}

.list-row--hover {
  opacity: 0.92;
}

/* 凭证图片上传区域 */
.evidence-section {
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.evidence-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.evidence-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.evidence-img {
  width: 100%;
  height: 100%;
}

.evidence-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  border-bottom-left-radius: 12rpx;
}

.evidence-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border: 2rpx dashed #d0d5dd;
}

.evidence-add-icon {
  font-size: 44rpx;
  color: #98a2b3;
  line-height: 1;
}

.evidence-add-text {
  font-size: 20rpx;
  color: #98a2b3;
  margin-top: 4rpx;
}
