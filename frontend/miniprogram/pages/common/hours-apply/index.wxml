<view class="page-shell">
  <view class="container">
    <view class="page-hero">
      <view class="page-hero-title">志愿时长申请</view>
    </view>

    <view class="card" style="margin-bottom: 24rpx;">
      <view class="section-title">填写服务记录</view>
      <picker mode="selector" range="{{pairList}}" range-key="label" bindchange="onPairChange">
        <view class="list-row">
          <text>结对</text>
          <text>{{pairList[pairIndex] ? pairList[pairIndex].label : '请选择结对'}}</text>
        </view>
      </picker>
      <view class="list-row">
        <text>时长(小时)</text>
        <input placeholder="例如 2" value="{{hoursInput}}" bindinput="onHoursInput" />
      </view>
      <view class="list-row">
        <text>日期</text>
        <picker mode="date" value="{{dateInput}}" start="2020-01-01" end="2040-12-31" bindchange="onDateChange">
          <view class="hours-date-picker">{{dateInput || '选择日期'}}</view>
        </picker>
      </view>
      <view class="list-row">
        <text>说明</text>
        <input placeholder="可选" value="{{serviceDesc}}" bindinput="onServiceDescInput" />
      </view>
      <button class="primary-btn" bindtap="onSubmit" style="margin-top: 20rpx;">提交申请</button>
    </view>

    <view class="card">
      <view class="section-title">我的申请</view>
      <view wx:if="{{myList.length}}">
        <view class="list-row" wx:for="{{myList}}" wx:key="id" bindtap="onViewItem" data-id="{{item.id}}">
          <text>{{item.week}} · {{item.hours}}h</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>
      <view wx:else class="empty-state">暂无记录</view>
    </view>
  </view>
</view>
