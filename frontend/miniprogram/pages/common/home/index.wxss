/* 与 shell-mesh 搭配：本页不重复铺底色 */
.home-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: linear-gradient(180deg, #e0f2fe 0%, #f5f7fa 100%);
  animation: backgroundFade 8s infinite;
}

@keyframes backgroundFade {
  0% { background: linear-gradient(180deg, #e0f2fe 0%, #f5f7fa 100%); }
  50% { background: linear-gradient(180deg, #eef2ff 0%, #f5f7fa 100%); }
  100% { background: linear-gradient(180deg, #e0f2fe 0%, #f5f7fa 100%); }
}

.home-content {
  position: relative;
  z-index: 1;
  padding: 0 0 8rpx;
  box-sizing: border-box;
}

/* ---------- 分层 Hero ---------- */

.home-hero--layered {
  position: relative;
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--ui-hero-start) 0%, var(--ui-hero-end) 100%);
  box-shadow: 0 25rpx 60rpx rgba(var(--ui-hero-shadow), 0.35);
  transform: translateY(0);
  transition: transform 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  width: 100%;
  box-sizing: border-box;
}

.home-hero--layered:hover {
  transform: translateY(-10rpx);
  box-shadow: 0 35rpx 80rpx rgba(var(--ui-hero-shadow), 0.5);
}

.home-hero-glow {
  position: absolute;
  top: -50%;
  left: 50%;
  width: 160%;
  height: 120%;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(56, 189, 248, 0.25) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
  animation: glow 3s infinite;
}

@keyframes glow {
  0% { opacity: 1; transform: translateX(-50%) scale(1); }
  50% { opacity: 0.5; transform: translateX(-50%) scale(1.1); }
  100% { opacity: 1; transform: translateX(-50%) scale(1); }
}

.home-hero--layered .home-brand,
.home-hero--layered .home-hero-eyebrow,
.home-hero--layered .home-title,
.home-hero--layered .home-subtitle,
.home-hero--layered .home-hero-kpis,
.home-hero--layered .home-badge-row {
  position: relative;
  z-index: 1;
}

.home-hero-eyebrow {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: #ffffff;
  margin-top: 12rpx;
  font-style: italic;
  text-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.home-hero-kpis {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24rpx 36rpx;
  margin: 40rpx 0 12rpx;
  padding: 0 10rpx;
}

.home-kpi {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 16rpx rgba(16, 24, 40, 0.06);
  transition: transform 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
  min-width: 120rpx;
  height: 60rpx;
}

.home-kpi:hover {
  transform: scale(1.03);
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.1);
}

.home-kpi-t {
  font-size: 22rpx;
  color: #344054;
  font-weight: 700;
  text-align: center;
}

.home-kpi-i {
  width: 32rpx;
  height: 32rpx;
}

.home-brand {
  position: relative;
  z-index: 1;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, var(--ui-hero-start) 0%, var(--ui-hero-end) 100%);
  box-shadow: 0 30rpx 70rpx rgba(var(--ui-hero-shadow), 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 3s infinite;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

@keyframes pulse {
  0% { transform: scale(1); box-shadow: 0 30rpx 70rpx rgba(var(--ui-hero-shadow), 0.5); }
  50% { transform: scale(1.08); box-shadow: 0 40rpx 90rpx rgba(var(--ui-hero-shadow), 0.6); }
  100% { transform: scale(1); box-shadow: 0 30rpx 70rpx rgba(var(--ui-hero-shadow), 0.5); }
}

.home-brand-badge-wrap {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  transform: scale(0.95);
  transform-origin: top right;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
  border: 2rpx solid var(--ui-primary);
}

.home-hero-eyebrow {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #667085;
  margin-top: 8rpx;
  font-style: italic;
}

.home-hero-kpis {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20rpx 32rpx;
  margin: 32rpx 0 8rpx;
  padding: 0 8rpx;
}

.home-kpi {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 6rpx 20rpx rgba(16, 24, 40, 0.06);
  transition: transform 0.2s ease-in-out;
}

.home-kpi:hover {
  transform: scale(1.05);
}

.home-kpi-t {
  font-size: 36rpx;
  color: #344054;
  font-weight: 800;
}

.home-brand {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, var(--ui-hero-start) 0%, var(--ui-hero-end) 100%);
  box-shadow: 0 20rpx 48rpx rgba(var(--ui-hero-shadow), 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 3s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

.home-brand-badge-wrap {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  transform: scale(0.92);
  transform-origin: top right;
}

.home-brand-mark {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1;
}

.home-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #101828;
  letter-spacing: 4rpx;
}

.home-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #475467;
  line-height: 1.55;
  padding: 0 20rpx;
}

.home-badge-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.home-badge {
  font-size: 22rpx;
  color: var(--ui-link);
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.home-section {
  padding: 8rpx 40rpx 24rpx;
}

.home-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

/* ---------- 角色卡片 ---------- */

.home-role-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 320rpx;
  height: 320rpx;
  margin: 16rpx 0;
  border-radius: 16rpx;
  background-color: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.home-role-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.home-role-card--student {
  border-top: 8rpx solid #ea580c; /* 与 theme-student 一致 */
}

.home-role-card--teacher {
  border-top: 8rpx solid #0891b2; /* 与 theme-teacher 一致 */
}

.home-role-card--admin-l2 {
  border-top: 8rpx solid #3f6212; /* 与 theme-l2 一致 */
}

.home-role-card--admin-l1 {
  border-top: 8rpx solid #6366f1; /* 与 theme-l1 一致 */
}

.home-role-card-iam {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.home-role-card-hint {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #64748b;
}

.home-role-card-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.16;
}

/* ---------- 选择身份：独立卡片（与早期版式一致） ---------- */

.home-cards {
  padding: 0 32rpx;
}

.home-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid var(--ui-primary);
  box-shadow: 0 8rpx 32rpx rgba(16, 24, 40, 0.08);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.home-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(16, 24, 40, 0.06);
}

.home-card-iam {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
  letter-spacing: 1rpx;
}

.home-card-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #667085;
  line-height: 1.55;
}

.home-card-go {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.home-quick-login {
  margin: 8rpx 40rpx 0;
  padding: 0 0 8rpx;
  text-align: center;
}

.home-quick-login-link {
  font-size: 28rpx;
  color: var(--ui-link);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
