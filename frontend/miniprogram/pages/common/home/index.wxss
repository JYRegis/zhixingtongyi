.home-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(165deg, #173b7a 0%, #2659b2 38%, #3f80ea 100%);
}

.home-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(4, 18, 46, 0.26) 0%, rgba(8, 20, 50, 0.68) 100%);
}

.home-glow {
  position: absolute;
  z-index: 0;
  border-radius: 999rpx;
  filter: blur(12rpx);
}

.home-glow-top {
  top: -120rpx;
  right: -120rpx;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgba(185, 216, 255, 0.4) 0%, rgba(185, 216, 255, 0) 70%);
}

.home-glow-bottom {
  left: -160rpx;
  bottom: 180rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(246, 231, 184, 0.32) 0%, rgba(246, 231, 184, 0) 72%);
}

.home-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 120rpx 52rpx 90rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.home-brand-badge {
  align-self: flex-start;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8rpx);
}

.home-title-wrap {
  margin-top: 84rpx;
}

.home-title {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #ffffff;
  text-shadow: 0 10rpx 24rpx rgba(12, 30, 72, 0.36);
}

.home-subtitle {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 8rpx 20rpx rgba(12, 30, 72, 0.3);
}

.home-panel {
  margin-top: auto;
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.74) 100%);
  border-radius: 30rpx;
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 56rpx rgba(14, 31, 69, 0.22);
  backdrop-filter: blur(12rpx);
}

.home-panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f294d;
}

.home-panel-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #425466;
}

.home-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.home-btn::after {
  border: none;
}

.home-btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #3478f6 0%, #1f56d8 100%);
  box-shadow: 0 14rpx 30rpx rgba(30, 84, 214, 0.35);
}

.home-login-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #4a607a;
  text-align: center;
}
