<view class="home-page {{_roleThemeClass}} shell-mesh">
  <view class="home-content">
    <view class="home-hero home-hero--layered">
      <view class="home-hero-glow" aria-hidden="true"></view>
      <view class="home-brand">
        <text class="home-brand-mark">驿</text>
        <view class="home-brand-badge-wrap" style="display: none;">
          <text class="home-brand-badge"></text>
        </view>
      </view>
      <view class="home-title">云端连接</view>
      <view class="home-subtitle">温暖陪伴与学习</view>
    </view>

    <view class="home-cards">
      <view
        wx:for="{{cards}}"
        wx:key="value"
        class="home-card"
        style="border-left-color: {{item.accent}};"
        data-role="{{item.value}}"
        bindtap="onChooseRole"
      >
        <view class="home-card-iam">{{item.iam}}</view>
        <view class="home-card-hint" wx:if="{{item.hint}}">{{item.hint}}</view>
        <view class="home-card-go" style="color: {{item.accent}};">进入 →</view>
      </view>
    </view>

    <view class="home-quick-login">
      <text class="home-quick-login-link" bindtap="onQuickLogin">已有账号，仅手机号快速登录</text>
    </view>
  </view>
</view>
