.role-page {
  min-height: 100vh;
  padding: 56rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f1ff 0%, #f5f7fa 35%, #f5f7fa 100%);
}

.role-hero {
  padding: 0 8rpx 28rpx;
}

.role-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #101828;
}

.role-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #475467;
}

.role-cards {
  margin-top: 16rpx;
}

.role-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #3b82f6;
  box-shadow: 0 8rpx 32rpx rgba(16, 24, 40, 0.08);
}

.role-card:active {
  transform: scale(0.98);
}

.role-card-iam {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
}

.role-card-go {
  margin-top: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
}
