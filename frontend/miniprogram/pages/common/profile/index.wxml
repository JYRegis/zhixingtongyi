<view class="page-shell {{_roleThemeClass}}">
  <view class="container profile-page">
    <view class="page-hero">
      <view class="page-hero-title">{{heroTitle}}</view>
    </view>

    <view class="card profile-account-card">
      <view class="section-header profile-account-section-title">
        <view class="section-title">登录信息</view>
      </view>
      <view class="profile-account-body">
        <view class="profile-account-hero">
          <image
            wx:if="{{accAvatarUrl}}"
            class="profile-account-avatar profile-account-avatar--img"
            src="{{accAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="profile-account-avatar profile-account-avatar--text">{{accAvatarChar}}</view>
        </view>
        <view class="profile-account-text">
          <view class="profile-account-nick">{{accNickname}}</view>
          <view class="profile-account-phone">手机 {{accPhoneDisplay}}</view>
        </view>
      </view>
      <view class="profile-account-actions">
        <button class="btn-secondary" bindtap="onEditAccount">修改头像、昵称与手机</button>
      </view>
    </view>

    <block wx:for="{{sections}}" wx:key="key">
      <view class="section-header">
        <view class="section-title">{{item.title}}</view>
      </view>
      <view class="card profile-section-card">
        <block wx:for="{{item.fields}}" wx:key="key" wx:for-item="field">
          <view class="field profile-field">
            <text class="field-label">{{field.label}}</text>
            <picker
              wx:if="{{field.type === 'picker_school'}}"
              mode="selector"
              range="{{field.range}}"
              range-key="name"
              value="{{field.pickerValue}}"
              bindchange="onPickSchool"
            >
              <view
                class="field-input profile-field-input profile-picker-line {{!field.hasValue ? 'form-placeholder-std' : ''}}"
              >{{field.hasValue ? (field.lineText || '已选学校') : '请选择学校'}}</view>
            </picker>
            <picker
              wx:elif="{{field.type === 'picker_grade'}}"
              mode="selector"
              range="{{field.range}}"
              range-key="name"
              value="{{field.pickerValue}}"
              bindchange="onPickGrade"
            >
              <view
                class="field-input profile-field-input profile-picker-line {{!field.hasValue ? 'form-placeholder-std' : ''}}"
              >{{field.hasValue ? (field.lineText || '') : '请选择年级'}}</view>
            </picker>
            <!-- 时间选择 -->
            <view wx:if="{{field.type === 'time_chips'}}" class="form-row form-row--time-chips">
              <view class="form-label">{{field.label}}</view>
              <view class="form-time-chips-wrap">
                <view class="form-time-chips-title">星期</view>
                <view class="form-time-chips-row">
                  <view 
                    wx:for="{{field.weekChips}}" 
                    wx:key="id" 
                    class="form-time-chip {{item.on ? 'form-time-chip--on' : ''}}"
                    bindtap="onToggleProfileTime"
                    data-tfield="{{field.tfield}}"
                    data-tkind="week"
                    data-id="{{item.id}}"
                  >{{item.name}}</view>
                </view>
                <view class="form-time-chips-title">时段</view>
                <view class="form-time-chips-row">
                  <view 
                    wx:for="{{field.slotChips}}" 
                    wx:key="id" 
                    class="form-time-chip {{item.on ? 'form-time-chip--on' : ''}}"
                    bindtap="onToggleProfileTime"
                    data-tfield="{{field.tfield}}"
                    data-tkind="slot"
                    data-id="{{item.id}}"
                  >{{item.name}}</view>
                </view>
              </view>
            </view>
            <input
              wx:elif="{{field.type === 'input'}}"
              class="field-input profile-field-input"
              placeholder="{{field.placeholder}}"
              placeholder-class="form-placeholder-std"
              value="{{field.value}}"
              data-field="{{field.key}}"
              bindinput="onInput"
            />
            <textarea
              wx:elif="{{field.type === 'textarea'}}"
              class="field-textarea profile-field-textarea"
              placeholder="{{field.placeholder}}"
              placeholder-class="form-placeholder-std"
              value="{{field.value}}"
              data-field="{{field.key}}"
              bindinput="onInput"
            />
            <view class="profile-field-hint" wx:if="{{field.hint}}">{{field.hint}}</view>
          </view>
        </block>
      </view>
    </block>

    <view class="section-header" wx:if="{{showTeacherContinuousMatch}}">
      <view class="section-title">匹配偏好</view>
    </view>
    <view class="card profile-section-card" wx:if="{{showTeacherContinuousMatch}}">
      <view class="field profile-field" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap">
        <text class="field-label" style="flex: 1; min-width: 200rpx">持续匹配（连续结对意愿）</text>
        <switch
          checked="{{continuousMatchEnabled}}"
          disabled="{{continuousMatchLoading}}"
          bindchange="onContinuousMatchChange"
        />
      </view>
      <view class="profile-field-hint" style="margin-top: 12rpx">与服务器同步，用于后台记录志愿者是否愿意持续参与匹配；需已连接后端并登录。</view>
    </view>

    <view class="card profile-submit-card">
      <button class="btn-primary profile-submit-btn" bindtap="onSubmit">保存</button>
    </view>
  </view>
</view>
