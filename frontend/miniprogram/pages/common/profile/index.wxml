<view class="page-shell">
  <view class="container profile-page">
    <view class="page-hero">
      <view class="page-hero-eyebrow">{{heroEyebrow}}</view>
      <view class="page-hero-title">{{heroTitle}}</view>
      <view class="page-hero-desc">{{heroDesc}}</view>
      <view class="page-hero-badges">
        <view wx:for="{{heroBadges}}" wx:key="*this" class="hero-badge">{{item}}</view>
      </view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{summaryCards}}" wx:key="label" class="stat-grid-item">
        <view class="stat-card">
          <view class="stat-label">{{item.label}}</view>
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-note">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view class="surface-note">{{focusNote}}</view>

    <block wx:for="{{sections}}" wx:key="key">
      <view class="section-header">
        <view class="section-title">{{item.title}}</view>
        <view class="section-desc">{{item.desc}}</view>
      </view>
      <view class="card profile-section-card">
        <block wx:for="{{item.fields}}" wx:key="key" wx:for-item="field">
          <view class="field profile-field">
            <text class="field-label">{{field.label}}</text>
            <input
              wx:if="{{field.type === 'input'}}"
              class="field-input profile-field-input"
              placeholder="{{field.placeholder}}"
              value="{{field.value}}"
              data-field="{{field.key}}"
              bindinput="onInput"
            />
            <textarea
              wx:else
              class="field-textarea profile-field-textarea"
              placeholder="{{field.placeholder}}"
              value="{{field.value}}"
              data-field="{{field.key}}"
              bindinput="onInput"
            />
            <view class="profile-field-hint">{{field.hint}}</view>
          </view>
        </block>
      </view>
    </block>

    <view class="card profile-submit-card">
      <view class="title profile-submit-title">保存当前资料</view>
      <view class="desc">提交后资料将保存到你的个人档案中。</view>
      <button class="btn-primary profile-submit-btn" bindtap="onSubmit">提交资料</button>
    </view>
  </view>
</view>
