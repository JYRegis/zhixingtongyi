.profile-page {
  padding-bottom: 48rpx;
}

.profile-section-card,
.profile-submit-card {
  margin-top: 16rpx;
}

.profile-field:first-child {
  margin-top: 0;
}

.profile-field + .profile-field {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eaecf0;
}

/**
 * 资料页：全局 .field-input 对 input 同时设了 padding，在部分机型上单行文字会视觉上靠上。
 * 这里继续收紧单行 input 的纵向 padding，并配合更高的圆角和表单提示文案统一视觉。
 */
.profile-field-input {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.profile-field-textarea {
  min-height: 196rpx;
}

.profile-field-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #98a2b3;
}

.profile-submit-title {
  margin-bottom: 10rpx;
}

.profile-submit-btn {
  margin-top: 24rpx;
}
