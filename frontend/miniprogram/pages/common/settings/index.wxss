.settings-page {
  padding: 32rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.settings-main-hero {
  margin-bottom: 12rpx;
}

.settings-hero {
  margin-top: 20rpx;
  text-align: center;
  padding: 40rpx 32rpx 36rpx;
}

.settings-avatar {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, var(--ui-hero-start) 0%, var(--ui-hero-end) 100%);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-avatar--img {
  display: block;
  background: #eaecf0;
}

.settings-nickname {
  font-size: 34rpx;
  font-weight: 800;
  color: #333333;
}

.settings-role {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

.settings-role.muted {
  color: #999999;
}

.settings-list {
  margin-top: 16rpx;
  padding: 0;
  overflow: hidden;
}

.settings-row {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-row-btn:active {
  background: #f9fafb;
}

.settings-row-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #333333;
}

.settings-row-extra {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ui-link);
}

.settings-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  padding: 14rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  flex-shrink: 0;
}

.settings-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.settings-row-extra.muted {
  color: #999999;
}

.settings-logout-btn {
  margin: 0;
  width: 100%;
  border-radius: 0;
  background: #ffffff;
  color: #b42318;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 96rpx;
  height: 96rpx;
}

.settings-logout-btn::after {
  border: none;
}

.settings-footnote {
  margin-top: 40rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.55;
  text-align: center;
}

.settings-row-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}


.settings-row-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
