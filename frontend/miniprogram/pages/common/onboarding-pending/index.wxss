.ob-pend-page {
  padding-top: 64rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.ob-pend-card {
  text-align: center;
}

.ob-pend-ico {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.ob-pend-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #98a2b3;
  text-align: left;
}

.ob-pend-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
