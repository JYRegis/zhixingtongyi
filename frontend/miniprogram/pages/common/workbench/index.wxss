.workbench-page {
  padding-bottom: 48rpx;
}

.workbench-hero {
  overflow: hidden;
}

.workbench-hero-meta {
  margin-top: 20rpx;
}

.workbench-empty {
  margin-top: 8rpx;
}

.workbench-login-btn {
  margin-top: 24rpx;
}

.workbench-menu-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.workbench-menu-card {
  position: relative;
  overflow: hidden;
}

.workbench-menu-card--featured {
  border-color: rgba(59, 130, 246, 0.32);
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.12);
}

.workbench-menu-card--featured::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 10rpx;
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
}

.workbench-menu-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workbench-menu-mark {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #175cd3;
  background: #eef4ff;
}

.workbench-menu-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #101828;
}

.workbench-menu-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #667085;
}

.workbench-menu-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.workbench-menu-tip {
  font-size: 24rpx;
  color: #175cd3;
}

.workbench-menu-arrow {
  font-size: 24rpx;
  font-weight: 600;
  color: #175cd3;
}
