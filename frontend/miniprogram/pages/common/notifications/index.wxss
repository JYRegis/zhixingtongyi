.notif-page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.notif-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
  padding: 20rpx;
}
.notif-btn-all {
  font-size: 24rpx;
}
.notif-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.notif-item {
  padding: 24rpx;
}
.notif-item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2939;
  margin-bottom: 12rpx;
}
.notif-item-body {
  font-size: 28rpx;
  color: #475467;
  line-height: 1.5;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.notif-item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #98a2b3;
}
.notif-unread {
  color: #3b82f6;
  font-weight: 500;
}
.notif-read {
  color: #98a2b3;
}
