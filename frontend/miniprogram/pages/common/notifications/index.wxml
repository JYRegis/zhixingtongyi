<view class="page-shell {{_roleThemeClass}}">
  <view class="notif-page container">
    <view class="page-hero notif-hero">
      <view class="page-hero-eyebrow">NOTIFICATIONS</view>
      <view class="page-hero-title">系统通知</view>
      <view class="page-hero-desc">查看审核、结对、课堂与平台提醒</view>
    </view>

    <view wx:if="{{!loggedIn}}" class="card notif-empty-card">
      <view class="notif-empty-icon">通</view>
      <view class="empty-title">请先登录</view>
      <view class="empty-desc">登录后即可查看系统通知</view>
    </view>
    <block wx:elif="{{useApi}}">
      <view class="notif-bar card" wx:if="{{list.length}}">
        <button class="btn-secondary notif-btn-all" size="mini" bindtap="onMarkAllRead">全部标为已读</button>
      </view>
      <view class="card notif-empty-card" wx:if="{{!list.length && !loading}}">
        <view class="notif-empty-icon">空</view>
        <view class="empty-title">暂无通知</view>
        <view class="empty-desc">新的系统提醒会显示在这里</view>
      </view>
      <view class="notif-list">
        <view
          class="notif-item card"
          wx:for="{{list}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onRowTap"
        >
          <view class="notif-item-main">
            <view class="notif-item-icon">知</view>
            <view class="notif-item-content">
              <view class="notif-item-top">
                <view class="notif-item-title">{{item.titleText}}</view>
                <text class="notif-unread" wx:if="{{!item.isRead}}">未读</text>
                <text class="notif-read" wx:else>已读</text>
              </view>
              <view class="notif-item-body">{{item.contentText}}</view>
              <view class="notif-item-meta">
                <text class="notif-time">{{item.timeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="card notif-empty-card">
      <view class="notif-empty-icon">网</view>
      <view class="empty-title">通知占位</view>
      <view class="empty-desc">已关闭远程通知或当前无网络</view>
    </view>
  </view>
</view>
