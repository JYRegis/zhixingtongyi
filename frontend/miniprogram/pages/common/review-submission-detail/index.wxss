.sub-detail-page {
  padding-bottom: 40rpx;
}

.sub-detail-card {
  margin-top: 24rpx;
}

.sub-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.sub-detail-row:last-child {
  border-bottom: 0;
}

.sub-detail-k {
  flex: 0 0 200rpx;
  color: #999999;
}

.sub-detail-v {
  flex: 1;
  text-align: right;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}

.sub-detail-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-radius: 32rpx;
  padding: 34rpx 32rpx;
  border: none;
  margin-top: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(22, 119, 255, 0.24);
}

.sub-detail-hero .page-hero-title {
  color: #ffffff;
  font-size: 40rpx;
}

.sub-detail-hero .page-hero-eyebrow {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.78);
}

.sub-detail-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

.sub-detail-denied {
  margin-top: 24rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.sub-detail-denied-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.sub-detail-images {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.sub-detail-evidence-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}
