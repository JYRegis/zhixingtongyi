.auth-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fa 30%, #f5f7fa 100%);
  padding: 0 40rpx 80rpx;
  box-sizing: border-box;
}

/* ---------- top: avatar + title ---------- */

.auth-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: 48rpx;
}

.auth-avatar-btn {
  width: 180rpx !important;
  height: 180rpx !important;
  min-width: 0 !important;
  padding: 0 !important;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  border: 4rpx solid #e4e7ec;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: normal;
}

.auth-avatar-btn::after {
  border: none;
}

.auth-avatar-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: block;
}

.auth-avatar-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
}

.auth-avatar-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #93b4f5;
  position: relative;
}

.auth-avatar-icon::after {
  content: "";
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 40rpx;
  border-radius: 40rpx 40rpx 0 0;
  border: 4rpx solid #93b4f5;
  border-bottom: none;
}

.auth-top-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.auth-top-role {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3b82f6;
  background: #eff6ff;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

/* ---------- form ---------- */

.auth-form {
  margin-top: 8rpx;
}

.auth-group {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
}

.auth-group-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #101828;
  margin-bottom: 20rpx;
}

.auth-input-wrap {
  background: #f5f7fa;
  border-radius: 16rpx;
  overflow: hidden;
}

.auth-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #101828;
  background: transparent;
  border: none;
}

/* ---------- wx phone button ---------- */

.auth-wx-phone-btn {
  width: 100% !important;
  padding: 0 !important;
  margin: 0 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.auth-wx-phone-btn::after {
  border: none;
}

.auth-wx-phone-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.auth-wx-phone-icon {
  width: 36rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 8rpx;
  position: relative;
}

.auth-wx-phone-icon::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
}

/* ---------- saved phones ---------- */

.auth-saved-phones {
  margin-bottom: 20rpx;
}

.auth-saved-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #f5f7fa;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  letter-spacing: 2rpx;
}

.auth-saved-item--on {
  background: #eff6ff;
  color: #2563eb;
}

.auth-check-mark {
  font-size: 28rpx;
  color: #2563eb;
}

/* ---------- or divider ---------- */

.auth-or {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.auth-or-line {
  flex: 1;
  height: 1rpx;
  background: #e4e7ec;
}

.auth-or-text {
  font-size: 22rpx;
  color: #98a2b3;
  flex-shrink: 0;
}

/* ---------- submit ---------- */

.auth-submit-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 16rpx 36rpx rgba(37, 99, 235, 0.25);
}

.auth-submit-btn::after {
  border: none;
}

.auth-foot {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #98a2b3;
  line-height: 1.6;
}
