<view class="auth-page">
  <view class="auth-top">
    <view class="auth-top-title">登录</view>
    <view class="auth-top-tip">没有账号将自动注册，登录后再选择角色</view>
  </view>

  <view class="auth-form">
    <view class="auth-group">
      <view class="auth-group-title">手机号 <text class="field-req">*</text></view>
      <view class="auth-login-tip">点击下方按钮后将直接完成授权与登录，无需二次点击。</view>
      <button class="auth-wx-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        <view class="auth-wx-phone-inner">
          <view class="auth-wx-phone-icon"></view>
          <text>微信一键获取手机号并登录</text>
        </view>
      </button>

      <view class="auth-or">
        <view class="auth-or-line"></view>
        <text class="auth-or-text">或手机号注册/登录</text>
        <view class="auth-or-line"></view>
      </view>
      <view class="auth-input-wrap">
        <input
          class="auth-input"
          type="number"
          maxlength="11"
          placeholder="请输入 11 位手机号"
          value="{{manualPhone}}"
          bindinput="onManualPhoneInput"
        />
      </view>
      <button class="auth-submit-btn" bindtap="onManualSubmit">手机号登录</button>
    </view>
  </view>
</view>
