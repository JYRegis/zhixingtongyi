<view class="auth-page">
  <view class="auth-top">
    <view class="auth-top-title">欢迎回来</view>
  </view>

  <view class="auth-form">
    <view class="auth-group">
      <button class="auth-wx-phone-btn" bindtap="onWxIdentityLogin">
        <view class="auth-wx-phone-inner">
          <text>微信一键登录</text>
        </view>
      </button>

      <view class="auth-input-wrap">
        <input
          class="auth-input"
          type="number"
          maxlength="11"
          placeholder="请输入 11 位手机号"
          value="{{manualPhone}}"
          bindinput="onManualPhoneInput"
        />
      </view>
      <view class="auth-dev-tip">手机号登录仅用于开发测试</view>
      <button class="auth-submit-btn" bindtap="onManualSubmit">手机号登录</button>
    </view>
  </view>
</view>
