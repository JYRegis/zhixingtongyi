.unbind-pairlist {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.unbind-pair {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border: 1rpx solid #f0f0f0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.unbind-pair--on {
  border-color: rgba(22, 119, 255, 0.28);
  background: #f0f9ff;
  box-shadow: 0 12rpx 36rpx rgba(22, 119, 255, 0.12);
}

.unbind-pair-main {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.unbind-pair-line {
  font-size: 32rpx;
  font-weight: 800;
  color: #333333;
  line-height: 1.4;
}

.unbind-pair-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unbind-pair-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.unbind-pair-chev {
  font-size: 24rpx;
  color: var(--ui-primary);
  font-weight: 700;
}

.em {
  font-weight: 800;
  color: #333333;
  text-align: right;
  max-width: 68%;
  word-break: break-all;
}

.badge-muted {
  background: #f5f7fa;
  color: #999999;
}

.list-row .cell-multiline {
  flex: 1;
  text-align: right;
  line-height: 1.4;
  font-size: 28rpx;
  color: #333333;
}

.dividing-line {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0 16rpx;
}

.mini-title {
  font-size: 26rpx;
  color: #666666;
  font-weight: 800;
  margin-bottom: 12rpx;
}
