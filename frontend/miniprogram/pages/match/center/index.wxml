<view class="container">
  <view class="card">
    <view class="title">匹配中心</view>
    <view class="desc">按科目、时间与需求权重展示推荐志愿者，并支持申请处理与解绑入口。</view>
    <view class="chip-row">
      <view class="chip">角色：{{role}}</view>
      <view class="chip">持续匹配开关（后续接入）</view>
    </view>
  </view>

  <!-- 学校老师：必须先选定代哪位学员，再展示推荐与申请 -->
  <block wx:if="{{role === 'admin_level_2'}}">
    <view wx:if="{{!actingStudent}}" class="card match-proxy-card">
      <view class="title" style="font-size: 32rpx;">请先选择学员</view>
      <view class="desc">您是学校老师代管模式：发起匹配前须明确「替哪一位学生」操作。</view>
      <view class="section-title" style="margin-top: 20rpx;">本班 / 所辖学员</view>
      <view
        wx:for="{{proxyStudents}}"
        wx:key="id"
        class="match-proxy-row"
        data-id="{{item.id}}"
        bindtap="onPickProxyStudent"
      >
        <view>
          <text class="match-proxy-name">{{item.name}}</text>
          <text class="match-proxy-grade">（{{item.grade}}）</text>
        </view>
        <view class="match-proxy-meta">
          <text class="badge {{item.binding === '已绑定' ? 'badge-success' : 'badge-warning'}}">{{item.binding}}</text>
          <text class="badge {{item.progress === '结对中' ? 'badge-success' : 'badge-warning'}}" style="margin-left: 8rpx;">{{item.progress}}</text>
        </view>
        <view class="desc" style="margin-top: 8rpx;">编号 {{item.id}} · 点此选择</view>
      </view>
    </view>

    <view wx:else class="card match-acting-bar">
      <view class="match-acting-line">
        <text class="match-acting-label">当前代操作学员</text>
        <text class="match-acting-name">{{actingStudent.name}}（{{actingStudent.grade}}）</text>
      </view>
      <view class="desc">编号 {{actingStudent.id}} · 下方推荐与「发起结对申请」均针对该生。</view>
      <button class="btn-secondary" style="margin-top: 16rpx;" bindtap="onChangeProxyStudent">更换学员</button>
    </view>
  </block>

  <view wx:if="{{role !== 'admin_level_2' || actingStudent}}" class="card" style="margin-top: 20rpx;">
    <view class="list-row">
      <text>筛选科目</text>
      <picker mode="selector" range="{{subjectOptions}}" bindchange="onSubjectChange">
        <text>{{filterSubject}}</text>
      </picker>
    </view>
    <view class="actions">
      <button class="btn-secondary" bindtap="toRequests">申请处理</button>
      <button class="btn-secondary" bindtap="toUnbind">解绑申请</button>
    </view>
  </view>

  <block wx:if="{{role !== 'admin_level_2' || actingStudent}}">
    <block wx:for="{{renderList}}" wx:key="id">
      <view class="card" style="margin-top: 20rpx;">
        <view>{{item.teacher}} · {{item.subject}}</view>
        <view class="desc">可授课时间：{{item.time}}</view>
        <view class="desc">匹配分：{{item.score}} · 风格：{{item.style}}</view>
        <button class="btn-primary" data-id="{{item.id}}" bindtap="onApply">发起结对申请</button>
      </view>
    </block>
  </block>
</view>
