<view class="page-shell {{_roleThemeClass}}">
  <view class="container req-page">
  <view class="page-hero">
    <view class="page-hero-eyebrow">PAIRING TASKS</view>
    <view class="page-hero-title">结对待办</view>
    <view class="page-hero-desc">处理结对申请，确认双方时间与学习需求</view>
  </view>

  <view wx:if="{{pendingList.length === 0}}" class="card req-empty-card">
    <view class="req-empty-icon">待</view>
    <view class="empty-title">暂无待办</view>
    <view class="empty-desc">新的结对申请会显示在这里</view>
  </view>

  <block wx:for="{{pendingList}}" wx:key="id">
    <view class="card req-card">
      <view class="req-card-head">
        <view class="req-avatar">{{item.avatarText}}</view>
        <view class="req-main">
          <view class="req-name">{{item.primaryName}}</view>
          <view class="req-sub">{{item.primaryLabel}}</view>
        </view>
        <view class="req-status">待处理</view>
      </view>
      <view class="list-row">
        <text wx:if="{{isVolunteer}}">对方希望上课时间</text>
        <text wx:else>我的希望上课时间</text>
        <text>{{item.preferredTimeDisplay}}</text>
      </view>
      <view class="list-row">
        <text>提交时间</text>
        <text>{{item.appliedAtText}}</text>
      </view>
      <view class="list-row" wx:if="{{!isVolunteer}}">
        <text>状态</text>
        <text class="req-status-inline">待志愿者处理</text>
      </view>
      <view class="actions" wx:if="{{isVolunteer}}">
        <button class="btn-primary" data-id="{{item.id}}" bindtap="onAccept">接受</button>
        <button class="btn-secondary" data-id="{{item.id}}" bindtap="onOpenReject">拒绝</button>
      </view>
    </view>
  </block>

  <view
    wx:if="{{activeRejectId}}"
    class="req-reject-mask"
    catchtouchmove="preventScrollThrough"
    bindtap="onCancelReject"
  >
    <view class="req-reject-dialog" catchtap="onStopRejectDialogBubble" catchtouchmove="preventScrollThrough">
      <view class="title">填写不通过原因</view>
      <view class="field">
        <text class="field-label">拒绝理由（必填）</text>
        <textarea
          class="field-textarea"
          placeholder="请填写"
          value="{{rejectReason}}"
          bindinput="onInputReason"
        />
      </view>
      <view class="req-reject-actions">
        <button class="btn-secondary" bindtap="onCancelReject">取消</button>
        <button class="btn-primary" bindtap="onRejectConfirm">确认拒绝</button>
      </view>
    </view>
  </view>
  </view>
</view>
