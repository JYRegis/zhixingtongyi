<view class="page-shell {{_roleThemeClass}}">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-title">支教方</view>
    </view>
    <view wx:if="{{!list.length}}" class="card region-empty-card">
      <view class="region-empty-icon">志</view>
      <view class="empty-title">暂无待审</view>
      <view class="empty-desc">新的志愿者申请会显示在这里</view>
    </view>
    <block wx:for="{{list}}" wx:key="id">
      <view class="card region-student-card">
        <view class="region-student-main">
          <view class="region-student-avatar">志</view>
          <view>
            <view class="region-student-name">{{item.displayName}}</view>
            <view class="region-student-school">{{item.school}} · {{item.grade}}</view>
          </view>
        </view>
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onView" hover-class="list-row--hover" style="margin: -4rpx 0 0">
          <text>申请资料</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onApprove">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onReject">驳回</button>
        </view>
      </view>
    </block>
  </view>
</view>
