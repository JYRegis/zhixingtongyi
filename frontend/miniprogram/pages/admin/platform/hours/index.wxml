<view class="page-shell {{_roleThemeClass}}">
  <view class="container platform-page">
    <view class="page-hero">
      <view class="page-hero-eyebrow">HOURS REVIEW</view>
      <view class="page-hero-title">认定义务时长</view>
      <view class="page-hero-desc">审核志愿时长申请，确认服务记录真实有效</view>
    </view>

    <view wx:if="{{!pendingHours.length}}" class="card platform-empty-card">
      <view class="platform-empty-icon">时</view>
      <view class="empty-title">暂无待审</view>
      <view class="empty-desc">新的时长申请会显示在这里</view>
    </view>
    <block wx:for="{{pendingHours}}" wx:key="id">
      <view class="card platform-review-card">
        <view class="platform-review-head">
          <view class="platform-review-icon">时</view>
          <view class="platform-review-main">
            <view class="platform-review-title">{{item.hours}} 小时 · {{item.week}}</view>
            <view class="platform-review-desc">{{item.studentName}} / {{item.volunteerName}}</view>
          </view>
          <view class="platform-review-status">待审</view>
        </view>
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onViewHours" hover-class="list-row--hover">
          <text>提交内容</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="list-row">
          <text>受援校</text>
          <text>{{item.schoolName}}</text>
        </view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onHoursApprove">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onHoursReject">驳回</button>
        </view>
      </view>
    </block>
  </view>
</view>
