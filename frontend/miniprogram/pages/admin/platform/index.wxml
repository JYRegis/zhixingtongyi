<view class="container">
  <view class="card">
    <view class="title">平台管理看板</view>
    <view class="desc">平台侧查看全局数据、权限与异常结对，必要时介入处理。</view>
  </view>

  <view class="section-title">核心指标</view>
  <view class="card">
    <view class="list-row">
      <text>志愿者总数</text>
      <text>{{stats.volunteerCount}}</text>
    </view>
    <view class="list-row">
      <text>学员总数</text>
      <text>{{stats.studentCount}}</text>
    </view>
    <view class="list-row">
      <text>有效结对数</text>
      <text>{{stats.pairCount}}</text>
    </view>
    <view class="list-row">
      <text>待处理预警</text>
      <text class="badge badge-danger">{{stats.pendingAlerts}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="onAssignPermission">给学校老师开权限</button>
  </view>

  <view class="section-title">异常结对巡查</view>
  <block wx:for="{{exceptionPairs}}" wx:key="id">
    <view class="card" style="margin-top: 16rpx;">
      <view class="list-row">
        <text>结对编号</text>
        <text>{{item.id}}</text>
      </view>
      <view class="list-row">
        <text>异常原因</text>
        <text>{{item.reason}}</text>
      </view>
      <view class="list-row">
        <text>风险等级</text>
        <text class="badge {{item.risk === '高' ? 'badge-danger' : 'badge-warning'}}">{{item.risk}}</text>
      </view>
      <button class="btn-primary" data-id="{{item.id}}" bindtap="onForceUnbind" style="margin-top: 16rpx;">强制干预</button>
    </view>
  </block>
</view>
