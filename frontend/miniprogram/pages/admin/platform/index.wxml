<view class="page-shell {{_roleThemeClass}}">
  <view class="container platform-page">
    <view class="page-hero">
      <view class="page-hero-title">平台管理</view>
    </view>

    <view class="card platform-overview-card">
      <view class="section-title">数据</view>
      <view class="platform-kpi-list">
        <view class="list-row">
          <text>志愿者总数</text>
          <text>{{stats.volunteerCount}}</text>
        </view>
        <view class="list-row">
          <text>学员总数</text>
          <text>{{stats.studentCount}}</text>
        </view>
        <view class="list-row">
          <text>有效结对数</text>
          <text>{{stats.pairCount}}</text>
        </view>
        <view class="list-row">
          <text>累计服务时长</text>
          <text class="badge badge-danger">{{stats.pendingAlerts}}</text>
        </view>
      </view>
    </view>

    <view class="section-header">
      <view class="section-title">待办与分类</view>
    </view>

    <view class="card platform-entry-card" bindtap="goReviewStudent">
      <view class="platform-entry-row">
        <view class="platform-entry-icon">学</view>
        <view class="platform-entry-main">
          <view class="platform-entry-title">乡村学员</view>
          <view class="platform-entry-desc">查看学生注册与资料审核</view>
        </view>
        <view class="platform-entry-badge" wx:if="{{cStudent > 0}}">{{cStudent}}</view>
        <view class="platform-entry-arrow">›</view>
      </view>
    </view>

    <view class="card platform-entry-card" bindtap="goReviewTeacher">
      <view class="platform-entry-row">
        <view class="platform-entry-icon">教</view>
        <view class="platform-entry-main">
          <view class="platform-entry-title">支教志愿者</view>
          <view class="platform-entry-desc">处理志愿者入驻申请</view>
        </view>
        <view class="platform-entry-badge" wx:if="{{cTeacher > 0}}">{{cTeacher}}</view>
        <view class="platform-entry-arrow">›</view>
      </view>
    </view>

    <view class="card platform-entry-card" bindtap="goReviewL2">
      <view class="platform-entry-row">
        <view class="platform-entry-icon">校</view>
        <view class="platform-entry-main">
          <view class="platform-entry-title">学校老师</view>
          <view class="platform-entry-desc">确认学校侧管理身份</view>
        </view>
        <view class="platform-entry-badge" wx:if="{{cL2 > 0}}">{{cL2}}</view>
        <view class="platform-entry-arrow">›</view>
      </view>
    </view>



    <view class="card platform-entry-card" bindtap="goHours">
      <view class="platform-entry-row">
        <view class="platform-entry-icon">时</view>
        <view class="platform-entry-main">
          <view class="platform-entry-title">认定义务时长</view>
          <view class="platform-entry-desc">复核志愿服务时长记录</view>
        </view>
        <view class="platform-entry-badge platform-entry-badge--warn" wx:if="{{cHours > 0}}">{{cHours}}</view>
        <view class="platform-entry-arrow">›</view>
      </view>
    </view>





    <view class="card platform-entry-card" bindtap="goSecondaryAdmins">
      <view class="platform-entry-row">
        <view class="platform-entry-icon">权</view>
        <view class="platform-entry-main">
          <view class="platform-entry-title">二级管理员分配</view>
          <view class="platform-entry-desc">为用户分配学校管理权限</view>
        </view>
        <view class="platform-entry-arrow">›</view>
      </view>
    </view>

  </view>
  <custom-tab-bar id="custom-tab-bar" />
</view>
