<view class="page-shell {{_roleThemeClass}}">
  <view class="container platform-page">
    <view class="page-hero">
      <view class="page-hero-eyebrow">RISK CENTER</view>
      <view class="page-hero-title">异常与预警</view>
      <view class="page-hero-desc">跟进异常结对、沟通风险与平台提醒</view>
    </view>

    <view wx:if="{{!exceptionPairs.length}}" class="card platform-empty-card">
      <view class="platform-empty-icon">安</view>
      <view class="empty-title">暂无预警</view>
      <view class="empty-desc">当前没有需要处理的异常风险</view>
    </view>
    <block wx:for="{{exceptionPairs}}" wx:key="index" wx:for-index="index">
      <view class="card platform-risk-card">
        <view class="platform-risk-top">
          <view class="platform-review-icon">警</view>
          <view class="platform-review-main">
            <view class="platform-review-title">风险提醒</view>
            <view class="platform-review-desc">{{item.reason}}</view>
          </view>
          <view class="badge {{item.risk == '高' ? 'badge-danger' : 'badge-warning'}}">{{item.risk}}风险</view>
        </view>
        <button class="btn-primary platform-risk-btn" bindtap="onForceUnbind">处理</button>
      </view>
    </block>
  </view>
</view>
