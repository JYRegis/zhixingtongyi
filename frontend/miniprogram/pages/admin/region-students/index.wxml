<view class="page-shell {{_roleThemeClass}}">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-title">受援方</view>
    </view>
    <view wx:if="{{!list.length}}" class="card">
      <view class="section-desc">暂无待审</view>
    </view>
    <block wx:for="{{list}}" wx:key="id">
      <view class="card">
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onViewOnboarding" hover-class="list-row--hover" style="margin: -4rpx 0 0">
          <text>申请资料</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="list-row">
          <text>姓名</text>
          <text>{{item.displayName}}</text>
        </view>
        <view class="list-row">
          <text>学校</text>
          <text>{{item.schoolName}}</text>
        </view>
        <view class="list-row">
          <text>年级</text>
          <text>{{item.grade}}</text>
        </view>
        <view class="list-row list-row--time">
          <text>可上课时间</text>
          <text class="list-row-ellipsis--time">{{item.timeText}}</text>
        </view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onApproveL2">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onRejectL2">驳回</button>
        </view>
      </view>
    </block>
  </view>
</view>
