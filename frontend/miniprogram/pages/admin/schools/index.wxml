<view class="page-shell">
  <view class="container">
    <view class="page-hero">
      <view class="page-hero-title">添加学校</view>
    </view>
    
    <view class="card">
      <view class="field">
        <text class="field-label">学校名称 <text class="field-req">*</text></text>
        <input class="field-input" placeholder="请输入学校名称" data-k="name" value="{{name}}" bindinput="onInput" />
      </view>

      <view class="field">
        <text class="field-label">学校类型 <text class="field-req">*</text></text>
        <picker range="{{schoolTypes}}" range-key="name" value="{{typeIndex}}" bindchange="onPickType">
          <view class="field-input picker-line">{{schoolTypes[typeIndex].name}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">地区编码 <text class="field-req">*</text></text>
        <input class="field-input" placeholder="请输入地区编码，如 reg_yn" data-k="regionCode" value="{{regionCode}}" bindinput="onInput" />
      </view>

      <view class="field">
        <text class="field-label">详细地址 <text class="field-req">*</text></text>
        <input class="field-input" placeholder="请输入学校详细地址" data-k="address" value="{{address}}" bindinput="onInput" />
      </view>

      <view class="field">
        <text class="field-label">学校联系人 <text class="field-req">*</text></text>
        <input class="field-input" placeholder="请输入联系人姓名" data-k="contactPerson" value="{{contactPerson}}" bindinput="onInput" />
      </view>

      <view class="field">
        <text class="field-label">联系电话 <text class="field-req">*</text></text>
        <input class="field-input" placeholder="请输入联系电话" data-k="contactPhone" value="{{contactPhone}}" bindinput="onInput" />
      </view>

      <button class="primary-btn" bindtap="onSubmit">创建学校</button>
    </view>
  </view>
</view>
