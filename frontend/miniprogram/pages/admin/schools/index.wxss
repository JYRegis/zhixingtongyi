.page-shell {
  padding-bottom: 48rpx;
}

.card {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #344054;
  margin-bottom: 12rpx;
}

.field-req {
  color: #b42318;
  margin-left: 4rpx;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  color: #0f172a;
  font-size: 28rpx;
}

.picker-line {
  display: flex;
  align-items: center;
}

.primary-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 36rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn:active {
  opacity: 0.9;
}
