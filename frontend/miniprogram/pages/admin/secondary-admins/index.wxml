<view class="page-shell">
  <view class="container sa-page">
    <view class="page-hero">
      <view class="page-hero-title">二级管理员分配</view>
    </view>

    <view class="section-header">
      <view class="section-title">用户信息</view>
    </view>
    <view class="sa-list card">
      <view class="sa-row">
        <image class="sa-row-icon" src="/images/icons/user-circle.svg" mode="aspectFit" />
        <view class="sa-row-main">
          <text class="sa-row-label">邀请码</text>
          <view class="sa-row-input-wrap">
            <input class="sa-row-input" placeholder="输入对方的邀请码（数字）" type="number" value="{{userId}}" bindinput="onUserIdInput" />
          </view>
        </view>
      </view>
    </view>

    <view class="section-header">
      <view class="section-title">分配信息</view>
    </view>
    <view class="sa-list card">
      <view class="sa-row">
        <image class="sa-row-icon" src="/images/icons/admin.svg" mode="aspectFit" />
        <view class="sa-row-main">
          <text class="sa-row-label">管理员类型</text>
          <picker mode="selector" range="{{roleTypeNames}}" value="{{roleTypeIndex}}" bindchange="onRoleTypeChange">
            <view class="sa-row-picker">{{roleTypeNames[roleTypeIndex]}}</view>
          </picker>
        </view>
      </view>
      <view class="sa-row">
        <image class="sa-row-icon" src="/images/icons/school.svg" mode="aspectFit" />
        <view class="sa-row-main">
          <text class="sa-row-label">管辖学校</text>
          <picker mode="selector" range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
            <view class="sa-row-picker {{schoolIndex >= 0 ? '' : 'sa-row-picker--placeholder'}}">
              {{schoolIndex >= 0 ? schoolNames[schoolIndex] : '请选择学校'}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="sa-submit-wrap">
      <button class="btn-primary sa-submit-btn" bindtap="onSubmit">提交分配</button>
    </view>
  </view>
</view>
