<view class="page-shell">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-title">受援方</view>
    </view>
    <view wx:if="{{!list.length}}" class="card">
      <view class="section-desc">暂无待审</view>
    </view>
    <block wx:for="{{list}}" wx:key="id">
      <view class="card">
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onViewHours" hover-class="list-row--hover" style="margin: -4rpx 0 0">
          <text>提交内容</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="list-row">
          <text>学员 / 志愿者</text>
          <text>{{item.studentName}} / {{item.volunteerName}}</text>
        </view>
        <view class="list-row">
          <text>认定义务时长</text>
          <text>{{item.hours}} 小时 · {{item.week}}</text>
        </view>
        <view class="list-row">
          <text>受援校</text>
          <text>{{item.schoolName}}</text>
        </view>
        <view class="list-row">
          <text>状态</text>
          <text>待审</text>
        </view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onApproveHours">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onRejectHours">驳回</button>
        </view>
      </view>
    </block>
  </view>
</view>
