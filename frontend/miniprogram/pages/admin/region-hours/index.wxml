<view class="page-shell {{_roleThemeClass}}">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-title">认定义务时长</view>
    </view>
    <view wx:if="{{!list.length}}" class="card region-empty-card">
      <view class="region-empty-icon">时</view>
      <view class="empty-title">暂无待审</view>
      <view class="empty-desc">新的时长记录会显示在这里</view>
    </view>
    <block wx:for="{{list}}" wx:key="id">
      <view class="card region-student-card">
        <view class="region-student-main">
          <view class="region-student-avatar">时</view>
          <view>
            <view class="region-student-name">{{item.studentName}}</view>
            <view class="region-student-school">{{item.volunteerName}} · {{item.schoolName}}</view>
          </view>
        </view>
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onViewHours" hover-class="list-row--hover" style="margin: -4rpx 0 0">
          <text>记录详情</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="list-row list-row--time">
          <text>认定时长</text>
          <text class="list-row-ellipsis--time">{{item.hours}} 小时</text>
        </view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onApproveHours">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onRejectHours">驳回</button>
        </view>
      </view>
    </block>
  </view>
</view>
