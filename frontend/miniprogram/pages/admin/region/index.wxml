<view class="page-shell">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-eyebrow">区域协同</view>
      <view class="page-hero-title">区域管理看板</view>
      <view class="page-hero-desc">围绕代管账号、学生状态与身份审核，统一管理区域内的学员信息。</view>
      <view class="page-hero-badges">
        <view class="hero-badge">管辖区域：{{regionName}}</view>
        <view class="hero-badge">支持代操作联动</view>
        <view class="hero-badge">操作便捷</view>
      </view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{summaryCards}}" wx:key="label" class="stat-grid-item">
        <view class="stat-card">
          <view class="stat-label">{{item.label}}</view>
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-note">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view class="card region-actions-card">
      <view class="section-title">常用操作</view>
      <view class="section-desc">先完成区域内账号和审核动作，再从学员列表里选择当前需要代操作的学生。</view>
      <view class="actions">
        <button class="btn-primary" bindtap="onCreateAccount">新增学员账号</button>
        <button class="btn-secondary" bindtap="onReviewIdentity">发起身份审核</button>
      </view>
    </view>

    <view wx:if="{{actingStudent}}" class="card region-acting-card">
      <view class="section-title">当前代操作学员</view>
      <view class="section-desc">{{actingStudent.name}}（{{actingStudent.grade}}）· 编号 {{actingStudent.id}}。与「匹配」Tab 共用同一学员选择，便于你直接跳转继续发起结对。</view>
    </view>

    <view class="section-header">
      <view class="section-title">学员列表</view>
      <view class="section-desc">点击某位学生即可将其设为当前代操作对象，并同步到匹配页使用。</view>
    </view>
    <block wx:for="{{students}}" wx:key="id">
      <view class="card region-student-card {{selectedStudentId === item.id ? 'region-student-card--active' : ''}}" data-id="{{item.id}}" bindtap="onSelectStudent">
        <view class="region-student-top">
          <view>
            <view class="region-student-name">{{item.name}}（{{item.grade}}）</view>
            <view class="desc">编号 {{item.id}}</view>
          </view>
          <view class="region-student-action">{{selectedStudentId === item.id ? '当前学员' : '设为当前'}}</view>
        </view>
        <view class="chip-row region-chip-row">
          <view class="chip">绑定：{{item.binding}}</view>
          <view class="chip">结对：{{item.progress}}</view>
        </view>
        <view class="region-student-badges">
          <text class="badge {{item.binding === '已绑定' ? 'badge-success' : 'badge-warning'}}">{{item.binding}}</text>
          <text class="badge {{item.progress === '结对中' ? 'badge-success' : 'badge-warning'}}">{{item.progress}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
