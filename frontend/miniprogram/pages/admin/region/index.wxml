<view class="page-shell {{_roleThemeClass}}">
  <view class="container region-page">
    <view class="page-hero">
      <view class="page-hero-title" wx:if="{{hasScope}}">{{regionName}}</view>
      <view class="page-hero-title" wx:else>区域</view>
    </view>

    <view class="section-header" wx:if="{{l2Scope === 'volunteer_side' && hasScope}}">
      <view class="section-title">志愿者注册</view>
    </view>
    <view wx:if="{{l2Scope === 'volunteer_side' && hasScope && !volunteerReviewList.length}}" class="card">
      <view class="section-desc">暂无待审</view>
    </view>
    <block wx:if="{{l2Scope === 'volunteer_side' && hasScope}}" wx:for="{{volunteerReviewList}}" wx:key="id">
      <view class="card region-student-card">
        <view class="list-row list-row--tappable" data-id="{{item.id}}" bindtap="onViewOnboarding" hover-class="list-row--hover" style="margin: -4rpx 0 8rpx">
          <text>申请资料</text>
          <text class="list-row-cta">查看 ›</text>
        </view>
        <view class="region-student-name">{{item.displayName}} · {{item.schoolName}}</view>
        <view class="list-row" wx:if="{{item.workNo && item.workNo !== '—'}}">
          <text>学工号</text>
          <text>{{item.workNo}}</text>
        </view>
        <view class="desc" wx:if="{{item.timeText && item.timeText !== '—'}}">可授课时间：{{item.timeText}}</view>
        <view class="actions">
          <button class="btn-primary" data-id="{{item.id}}" bindtap="onApproveL2">通过</button>
          <button class="btn-secondary" data-id="{{item.id}}" bindtap="onRejectL2">驳回</button>
        </view>
      </view>
    </block>

    <view class="card region-recipient-hub" wx:if="{{l2Scope === 'recipient_side' && hasScope}}">
      <view class="section-title" style="margin-bottom: 16rpx">本区管理</view>
      <view class="region-recipient-btns">
        <button
          class="region-jump-item"
          bindtap="toRegionStudents"
          plain="{{true}}"
          hover-class="list-row--hover"
          hover-stay-time="100"
        >
          <view class="region-jump-top">
            <view class="region-jump-name">学生注册审核</view>
            <view class="region-jump-cta">进入</view>
          </view>
          <view class="region-jump-meta" wx:if="{{studentRegCount > 0}}">待审 {{studentRegCount}} 条</view>
          <view class="region-jump-meta" wx:else>暂无待审</view>
        </button>
        <button
          class="region-jump-item"
          bindtap="toRegionHours"
          plain="{{true}}"
          hover-class="list-row--hover"
          hover-stay-time="100"
        >
          <view class="region-jump-top">
            <view class="region-jump-name">认定义务时长</view>
            <view class="region-jump-cta">进入</view>
          </view>
          <view class="region-jump-meta" wx:if="{{hoursCount > 0}}">待审 {{hoursCount}} 条</view>
          <view class="region-jump-meta" wx:else>暂无待审</view>
        </button>
      </view>
    </view>

    <view class="card region-actions-card" wx:if="{{!hasScope || l2Scope === 'recipient_side'}}">
      <view class="section-title" wx:if="{{!hasScope}}">未分配</view>
      <view class="section-title" wx:elif="{{l2Scope === 'recipient_side'}}">本区</view>
      <view class="actions" wx:if="{{!hasScope || l2Scope === 'recipient_side'}}">
        <button class="btn-primary" wx:if="{{l2Scope === 'recipient_side'}}" bindtap="onCreateAccount">登记学员</button>
        <button class="btn-secondary" bindtap="onCreateAccount" wx:if="{{!hasScope}}">查看</button>
      </view>
    </view>
  </view>
</view>
