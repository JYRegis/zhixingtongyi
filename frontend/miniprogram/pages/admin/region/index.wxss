.list-row-ellipsis {
  max-width: 60%;
  word-break: break-all;
  text-align: right;
  font-size: 28rpx;
  color: #3b4453;
}

.region-page {
  padding-bottom: 48rpx;
}

.region-actions-card,
.region-acting-card,
.region-student-card {
  margin-top: 20rpx;
}

.region-student-card {
  transition: border-color 0.2s ease;
}

.region-student-card--active {
  border-color: rgba(59, 130, 246, 0.4);
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.12);
}

.region-student-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.region-student-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #101828;
}

.region-student-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #175cd3;
}

.region-chip-row {
  margin-top: 18rpx;
}

.region-student-badges {
  margin-top: 18rpx;
}

/* 受援方：两个入口 */
.region-recipient-hub {
  margin-top: 20rpx;
}

.region-recipient-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

button.region-jump-item {
  margin: 0;
  width: 100%;
  text-align: left;
  line-height: inherit;
  font-weight: inherit;
  font-size: inherit;
  color: inherit;
  padding: 24rpx 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  background: #f9fafb;
}

button.region-jump-item::after {
  border: none;
}

.region-jump-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.region-jump-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.region-jump-cta {
  font-size: 26rpx;
  color: #175cd3;
  font-weight: 600;
}

.region-jump-meta {
  font-size: 24rpx;
  color: #667085;
  line-height: 1.4;
}
