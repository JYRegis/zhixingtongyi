.list-row-ellipsis {
  max-width: 60%;
  word-break: break-all;
  text-align: right;
  font-size: 28rpx;
  color: #3b4453;
}

.region-page {
  padding-bottom: 48rpx;
}

.region-actions-card,
.region-acting-card,
.region-student-card {
  margin-top: 20rpx;
}

.region-student-card {
  padding: 28rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.region-student-card--active {
  border-color: rgba(255, 140, 0, 0.28);
  box-shadow: 0 14rpx 36rpx rgba(255, 140, 0, 0.12);
}

.region-student-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.region-student-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #333333;
}

.region-student-action {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ui-primary);
}

.region-student-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.region-student-avatar,
.region-jump-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.region-student-school {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.region-chip-row {
  margin-top: 18rpx;
}

.region-student-badges {
  margin-top: 18rpx;
}

/* 受援方：两个入口 */
.region-recipient-hub {
  margin-top: 20rpx;
}

.region-empty-card {
  margin-top: 20rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.region-empty-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  color: var(--ui-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.region-recipient-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

button.region-jump-item {
  margin: 0;
  width: 100%;
  text-align: left;
  line-height: inherit;
  font-weight: inherit;
  font-size: inherit;
  color: inherit;
  padding: 26rpx 22rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

button.region-jump-item::after {
  border: none;
}

.region-jump-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.region-jump-main {
  flex: 1;
  min-width: 0;
}

.region-jump-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #333333;
}

.region-jump-cta {
  font-size: 26rpx;
  color: var(--ui-primary);
  font-weight: 700;
}

.region-jump-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}
