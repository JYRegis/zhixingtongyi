/**
 * 分角色 .theme-* 挂 CSS 变量；全站统一为蓝色主题，不同角色仅在浅色辅助色上保留细微差异。
 */

page {
  --ui-primary: #1677ff;
  --ui-primary-mid: #4096ff;
  --ui-hero-start: #1677ff;
  --ui-hero-end: #4096ff;
  --ui-hero-shadow: 22, 119, 255;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(22, 119, 255, 0.12);
  --ui-link: #1677ff;
  --ui-chip-bg: #e6f4ff;
  --ui-chip-text: #0958d9;
  --ui-surface-note-bg: #e6f4ff;
  --ui-surface-note-text: #0958d9;
  --ui-btn-secondary-fg: #0958d9;
  --ui-btn-secondary-bg: #e6f4ff;
  --ui-btn-secondary-border: #91caff;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #e0f2fe;
  --ui-auth-bg-1: #f0f9ff;
  --ui-auth-bg-2: #e0f2fe;
  --ui-auth-avatar-empty-1: #bfdbfe;
  --ui-auth-avatar-empty-2: #e0f2fe;
  --ui-saved-on-bg: #dbeafe;
  --ui-saved-on-fg: #1e3a8a;
}

/* 未登录 / 选角前：标准蓝主题 */
