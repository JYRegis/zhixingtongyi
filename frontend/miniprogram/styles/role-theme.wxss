/* ---------- 底栏选中（依赖 addGlobalClass，!important 以覆盖组件内默认蓝） ---------- */
.tab-bar.theme-guest .tab-bar-item--active { color: #1677ff !important; }
.tab-bar.theme-student .tab-bar-item--active { color: #1677ff !important; }
.tab-bar.theme-teacher .tab-bar-item--active { color: #1677ff !important; }
.tab-bar.theme-l2 .tab-bar-item--active { color: #1677ff !important; }
.tab-bar.theme-l1 .tab-bar-item--active { color: #1677ff !important; }

/* 与 app.wxss 的 .shell-mesh / .card-tier 共用本文件中的 --ui-page-bg、--ui-radial 等变量，分角色自动换色 */
