/**
 * 分角色 .theme-* 挂 CSS 变量；未登录首页（theme-guest）为清爽天蓝/蔚蓝系，与学员暖橙、志愿者青等区分。
 */

page {
  --ui-primary: #ff8c00;
  --ui-primary-mid: #ff9f1a;
  --ui-hero-start: #ff8c00;
  --ui-hero-end: #ffa500;
  --ui-hero-shadow: 255, 140, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 165, 0, 0.12);
  --ui-link: #ff8c00;
  --ui-chip-bg: #fff3df;
  --ui-chip-text: #b65f00;
  --ui-surface-note-bg: #fff7ed;
  --ui-surface-note-text: #b65f00;
  --ui-btn-secondary-fg: #b65f00;
  --ui-btn-secondary-bg: #fff7ed;
  --ui-btn-secondary-border: #ffd596;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #e0f2fe;
  --ui-auth-bg-1: #f0f9ff;
  --ui-auth-bg-2: #e0f2fe;
  --ui-auth-avatar-empty-1: #bfdbfe;
  --ui-auth-avatar-empty-2: #e0f2fe;
  --ui-saved-on-bg: #dbeafe;
  --ui-saved-on-fg: #1e3a8a;
}

/* 未登录 / 选角前：天蓝/蔚蓝（首页、落地选身份） - 增强 */
.theme-guest {
  --ui-primary: #ff8c00;
  --ui-primary-mid: #ff9f1a;
  --ui-hero-start: #ff8c00;
  --ui-hero-end: #ffa500;
  --ui-hero-shadow: 255, 140, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 165, 0, 0.12);
  --ui-link: #ff8c00;
  --ui-chip-bg: #fff3df;
  --ui-chip-text: #b65f00;
  --ui-surface-note-bg: #fff7ed;
  --ui-surface-note-text: #b65f00;
  --ui-btn-secondary-fg: #b65f00;
  --ui-btn-secondary-bg: #fff7ed;
  --ui-btn-secondary-border: #ffd596;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #e1f5fe;
  --ui-auth-bg-1: #e3f2fd;
  --ui-auth-bg-2: #bbdefb;
  --ui-auth-avatar-empty-1: #b3e5fc;
  --ui-auth-avatar-empty-2: #e1f5fe;
  --ui-saved-on-bg: #b3e5fc;
  --ui-saved-on-fg: #01579b;
}

/* 学员：暖橙/杏，Hero 柔和暖渐变 - 增强 */
.theme-student {
  --ui-primary: #f57c00;
  --ui-primary-mid: #e65100;
  --ui-hero-start: #ffa726;
  --ui-hero-end: #f57c00;
  --ui-hero-shadow: 245, 124, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 167, 38, 0.15);
  --ui-link: #f57c00;
  --ui-chip-bg: #ffe0b2;
  --ui-chip-text: #bf360c;
  --ui-surface-note-bg: #fff3e0;
  --ui-surface-note-text: #e65100;
  --ui-btn-secondary-fg: #e65100;
  --ui-btn-secondary-bg: #fff3e0;
  --ui-btn-secondary-border: #ffcc80;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #fff3e0;
  --ui-auth-bg-1: #fff3e0;
  --ui-auth-bg-2: #ffe0b2;
  --ui-auth-avatar-empty-1: #ffecb3;
  --ui-auth-avatar-empty-2: #ffe0b2;
  --ui-saved-on-bg: #ffe0b2;
  --ui-saved-on-fg: #e65100;
}

/* 志愿者：青蓝 / 蓝绿，行动与连接感 - 增强 */
.theme-teacher {
  --ui-primary: #ff8c00;
  --ui-primary-mid: #ff9f1a;
  --ui-hero-start: #ff8c00;
  --ui-hero-end: #ffa500;
  --ui-hero-shadow: 255, 140, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 165, 0, 0.12);
  --ui-link: #ff8c00;
  --ui-chip-bg: #fff3df;
  --ui-chip-text: #b65f00;
  --ui-surface-note-bg: #fff7ed;
  --ui-surface-note-text: #b65f00;
  --ui-btn-secondary-fg: #b65f00;
  --ui-btn-secondary-bg: #fff7ed;
  --ui-btn-secondary-border: #ffd596;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #e0f7fa;
  --ui-auth-bg-1: #e0f7fa;
  --ui-auth-bg-2: #b2ebf2;
  --ui-auth-avatar-empty-1: #b2ebf2;
  --ui-auth-avatar-empty-2: #e0f7fa;
  --ui-saved-on-bg: #b2ebf2;
  --ui-saved-on-fg: #00838f;
}

/* 学校老师：米白 + 墨绿/橄榄，书卷感 - 增强 */
.theme-l2 {
  --ui-primary: #ff8c00;
  --ui-primary-mid: #ff9f1a;
  --ui-hero-start: #ff8c00;
  --ui-hero-end: #ffa500;
  --ui-hero-shadow: 255, 140, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 165, 0, 0.12);
  --ui-link: #ff8c00;
  --ui-chip-bg: #fff3df;
  --ui-chip-text: #b65f00;
  --ui-surface-note-bg: #fff7ed;
  --ui-surface-note-text: #b65f00;
  --ui-btn-secondary-fg: #b65f00;
  --ui-btn-secondary-bg: #fff7ed;
  --ui-btn-secondary-border: #ffd596;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #f1f8e9;
  --ui-auth-bg-1: #f1f8e9;
  --ui-auth-bg-2: #dcedc8;
  --ui-auth-avatar-empty-1: #dcedc8;
  --ui-auth-avatar-empty-2: #f1f8e9;
  --ui-saved-on-bg: #dcedc8;
  --ui-saved-on-fg: #1b5e20;
}

/* 平台：中性灰 + 靛色单点，避免过暖 - 增强 */
.theme-l1 {
  --ui-primary: #ff8c00;
  --ui-primary-mid: #ff9f1a;
  --ui-hero-start: #ff8c00;
  --ui-hero-end: #ffa500;
  --ui-hero-shadow: 255, 140, 0;
  --ui-page-bg-1: #f5f7fa;
  --ui-page-bg-2: #f5f7fa;
  --ui-radial: rgba(255, 165, 0, 0.12);
  --ui-link: #ff8c00;
  --ui-chip-bg: #fff3df;
  --ui-chip-text: #b65f00;
  --ui-surface-note-bg: #fff7ed;
  --ui-surface-note-text: #b65f00;
  --ui-btn-secondary-fg: #b65f00;
  --ui-btn-secondary-bg: #fff7ed;
  --ui-btn-secondary-border: #ffd596;
  --ui-stat-top: #ffffff;
  --ui-stat-bot: #e8eaf6;
  --ui-auth-bg-1: #e8eaf6;
  --ui-auth-bg-2: #c5cae9;
  --ui-auth-avatar-empty-1: #c5cae9;
  --ui-auth-avatar-empty-2: #e8eaf6;
  --ui-saved-on-bg: #c5cae9;
  --ui-saved-on-fg: #1a237e;
}

/* ---------- 底栏选中（依赖 addGlobalClass，!important 以覆盖组件内默认蓝） ---------- */
.tab-bar.theme-guest .tab-bar-item--active { color: #ff8c00 !important; }
.tab-bar.theme-student .tab-bar-item--active { color: #f57c00 !important; }
.tab-bar.theme-teacher .tab-bar-item--active { color: #ff8c00 !important; }
.tab-bar.theme-l2 .tab-bar-item--active { color: #ff8c00 !important; }
.tab-bar.theme-l1 .tab-bar-item--active { color: #ff8c00 !important; }

/* 与 app.wxss 的 .shell-mesh / .card-tier 共用本文件中的 --ui-page-bg、--ui-radial 等变量，分角色自动换色 */
